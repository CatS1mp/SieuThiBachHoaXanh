@model BachHoaXanh.Models.FaceAuthHistory
@{
    ViewData["Title"] = "Chi tiết xác thực khuôn mặt";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="main-panel">
    <h2>Chi tiết xác thực khuôn mặt</h2>
    <dl class="row">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Model.Id</dd>

        <dt class="col-sm-2">User ID</dt>
        <dd class="col-sm-10">@Model.UserID</dd>

        <dt class="col-sm-2">Username</dt>
        <dd class="col-sm-10">@Model.User.UserName</dd>

        <dt class="col-sm-2">Thời gian xác thực</dt>
        <dd class="col-sm-10">@Model.AttemptTime.ToString("dd/MM/yyyy HH:mm:ss")</dd>

        <dt class="col-sm-2">Trạng thái</dt>
        <dd class="col-sm-10">@Model.Result</dd>

        <dt class="col-sm-2">Ảnh thất bại</dt>
        <dd class="col-sm-10">
            @if (!string.IsNullOrEmpty(Model.FailedImagePath))
            {
                <img src="~/face_images/@Model.FailedImagePath" alt="Failed Image" style="width: 100px; height: 100px;" />
            }
            else
            {
                <span>Không có ảnh</span>
            }
        </dd>
    </dl>
    <a href="@Url.Action("Auth", "Admin")" class="btn btn-secondary">Quay lại</a>
</div>