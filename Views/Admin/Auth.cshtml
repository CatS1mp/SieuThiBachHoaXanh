@model BachHoaXanh.ViewModels.FaceAuthienticationView
@{
    ViewData["Title"] = "Danh sách xác thực khuôn mặt";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastr@2.1.4/build/toastr.min.css" />
<script src="https://cdn.jsdelivr.net/npm/toastr@2.1.4/build/toastr.min.js"></script>
<style>
    .auth-card {
        max-width: 500px;
        margin: 0 auto;
        background: white;
        border-radius: 20px;
        box-shadow: 0 20px 40px rgba(76, 175, 80, 0.1);
        padding: 2.5rem;
        text-align: center;
        border: 2px solid #e8f5e8;
    }
    .popup-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0, 0, 0, 0.5); /* lớp mờ */
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .popup-content {
        left: 500px;
        padding: 30px;
        justify-content: center; /* căn giữa theo chiều ngang */
        align-items: center; /* căn giữa theo chiều dọc nếu cần */
        border-radius: 8px;
        max-width: 600px;
        width: 100%;
        position: relative;
    }

    .admin-container {
        background: linear-gradient(135deg, #f0f9f0 0%, #e8f5e8 100%);
        min-height: 100vh;
        padding: 0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .main-panel {
        background: transparent;
        padding: 0;
    }

    .admin-navbar {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border: none;
        box-shadow: 0 2px 20px rgba(76, 175, 80, 0.1);
        border-radius: 0 0 15px 15px;
        margin-bottom: 2rem;
        border-bottom: 3px solid #4caf50;
    }

    .navbar-brand {
        color: #2e7d32 !important;
        font-size: 1.5rem;
        font-weight: 700;
    }

    .navbar-nav a {
        color: #2e7d32 !important;
        font-weight: 600;
    }

    .content-wrapper {
        padding: 2rem;
        max-width: 1400px;
        margin: 0 auto;
    }

    .stats-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .stat-card {
        background: white;
        border-radius: 12px;
        padding: 1.5rem;
        text-align: center;
        box-shadow: 0 4px 20px rgba(76, 175, 80, 0.1);
        border: 2px solid #e8f5e8;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #4caf50, #66bb6a);
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 30px rgba(76, 175, 80, 0.2);
            border-color: #4caf50;
        }

    .stat-icon {
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
        color: #4caf50;
    }

    .stat-number {
        font-size: 2rem;
        font-weight: 700;
        color: #2e7d32;
        margin-bottom: 0.25rem;
    }

    .stat-label {
        color: #666;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* Tab Navigation Styles */
    .tab-navigation {
        background: white;
        border-radius: 15px;
        padding: 1rem;
        box-shadow: 0 4px 20px rgba(76, 175, 80, 0.1);
        border: 2px solid #e8f5e8;
        margin-bottom: 2rem;
    }

    .nav-tabs {
        border: none;
        display: flex;
        gap: 1rem;
    }

        .nav-tabs .nav-item {
            margin-bottom: 0;
        }

        .nav-tabs .nav-link {
            background: #f1f8e9;
            color: #2e7d32;
            border: 2px solid #e8f5e8;
            border-radius: 8px;
            padding: 12px 24px;
            font-weight: 600;
            transition: all 0.3s ease;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .nav-tabs .nav-link:hover {
                background: #e8f5e8;
                border-color: #4caf50;
                color: #2e7d32;
            }

            .nav-tabs .nav-link.active {
                background: #4caf50;
                color: white;
                border-color: #4caf50;
            }

    .table-card {
        background: white;
        border-radius: 15px;
        padding: 2rem;
        box-shadow: 0 4px 20px rgba(76, 175, 80, 0.1);
        border: 2px solid #e8f5e8;
    }

    .table-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        gap: 1rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #f1f8e9;
    }

    .table-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #2e7d32;
        margin: 0;
    }

    .custom-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        background: white;
        border-radius: 8px;
        overflow: hidden;
    }

        .custom-table thead th {
            background: #4caf50;
            color: white;
            padding: 1rem;
            font-weight: 600;
            text-align: left;
            border: none;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .custom-table tbody tr {
            transition: all 0.3s ease;
            border-bottom: 1px solid #f1f8e9;
        }

            .custom-table tbody tr:hover {
                background: #f8fdf8;
            }

            .custom-table tbody tr:nth-child(even) {
                background: #fafffe;
            }

                .custom-table tbody tr:nth-child(even):hover {
                    background: #f1f8e9;
                }

        .custom-table tbody td {
            padding: 1rem;
            vertical-align: middle;
            border: none;
            color: #333;
        }

    .user-id {
        font-weight: 700;
        color: #2e7d32;
        background: #f1f8e9;
        padding: 4px 8px;
        border-radius: 6px;
        display: inline-block;
    }

    .username {
        font-weight: 600;
        color: #2e7d32;
    }

    .auth-time {
        font-weight: 500;
        color: #666;
        font-family: 'Courier New', monospace;
        background: #f8f9fa;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.9rem;
    }

    .status-badge {
        padding: 6px 12px;
        border-radius: 15px;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border: 2px solid;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .status-success {
        background: #e8f5e8;
        color: #2e7d32;
        border-color: #4caf50;
    }

    .status-failed {
        background: #ffebee;
        color: #c62828;
        border-color: #f44336;
    }

    .status-unknown {
        background: #f5f5f5;
        color: #616161;
        border-color: #9e9e9e;
    }

    .btn-view-details {
        background: #4caf50;
        border: none;
        color: white;
        padding: 8px 16px;
        border-radius: 6px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.3s ease;
        font-size: 0.9rem;
    }

        .btn-view-details:hover {
            background: #45a049;
            transform: translateY(-1px);
            color: white;
            text-decoration: none;
        }

    /* Face Data Specific Styles */
    .face-image {
        width: 60px;
        height: 60px;
        border-radius: 8px;
        border: 2px solid #e8f5e8;
        object-fit: cover;
        transition: all 0.3s ease;
    }

        .face-image:hover {
            border-color: #4caf50;
            transform: scale(1.1);
        }

    .btn-add-face {
        background: #4caf50;
        border: none;
        color: white;
        padding: 8px 12px;
        border-radius: 6px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.3s ease;
        font-size: 0.85rem;
    }

        .btn-add-face:hover {
            background: #45a049;
            transform: translateY(-1px);
            color: white;
            text-decoration: none;
        }

    .btn-remove-face {
        background: #f44336;
        border: none;
        color: white;
        padding: 8px 12px;
        border-radius: 6px;
        font-weight: 600;
        transition: all 0.3s ease;
        font-size: 0.85rem;
    }

        .btn-remove-face:hover {
            background: #d32f2f;
            transform: translateY(-1px);
        }

    .action-buttons {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .tab-content {
        display: none;
    }

        .tab-content.active {
            display: block;
        }

    .dataTables_wrapper {
        margin-top: 1rem;
    }

    .dataTables_filter {
        margin-bottom: 1rem;
    }

        .dataTables_filter label {
            color: #2e7d32;
            font-weight: 600;
        }

        .dataTables_filter input {
            border: 2px solid #e8f5e8;
            border-radius: 8px;
            padding: 8px 16px;
            margin-left: 8px;
            transition: border-color 0.3s ease;
        }

            .dataTables_filter input:focus {
                border-color: #4caf50;
                outline: none;
                box-shadow: 0 0 0 3px rgba(76, 175, 80, 0.1);
            }

    .dataTables_info {
        color: #666;
        font-weight: 500;
    }

    .dataTables_paginate .paginate_button {
        border-radius: 6px !important;
        margin: 0 2px !important;
        border: 2px solid #e8f5e8 !important;
        background: white !important;
        color: #4caf50 !important;
        font-weight: 600 !important;
    }

        .dataTables_paginate .paginate_button:hover {
            background: #4caf50 !important;
            color: white !important;
            border-color: #4caf50 !important;
        }

        .dataTables_paginate .paginate_button.current {
            background: #4caf50 !important;
            color: white !important;
            border-color: #4caf50 !important;
        }

    @@media (max-width: 768px) {
        .content-wrapper

    {
        padding: 1rem;
    }

    .table-header {
        flex-direction: column;
        align-items: stretch;
    }

    .custom-table {
        font-size: 0.8rem;
    }

        .custom-table thead th,
        .custom-table tbody td {
            padding: 0.5rem;
        }

    .auth-time {
        font-size: 0.75rem;
    }

    .nav-tabs {
        flex-direction: column;
    }

    .action-buttons {
        flex-direction: column;
    }

    }
</style>

<div class="admin-container">
    <div class="main-panel">
        <nav class="navbar admin-navbar">
            <div class="container-fluid">
                <div class="navbar-header">
                    <a class="navbar-brand" href="#">
                        <i class="fas fa-user-shield"></i> Quản lý xác thực khuôn mặt
                    </a>
                </div>
                <div class="collapse navbar-collapse">
                    <ul class="nav navbar-nav navbar-right">
                        <li>
                            <a href="@Url.Action("Logout", "User")">
                                <i class="fas fa-sign-out-alt"></i> Đăng xuất tài khoản
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <div class="content-wrapper">
            <!-- Stats Cards -->
            <div class="stats-cards">
                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fas fa-user-check"></i>
                    </div>
                    <div class="stat-number">@Model.FaceAuthHistory.Count()</div>
                    <div class="stat-label">Tổng lần xác thực</div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <div class="stat-number">@Model.FaceAuthHistory.Count(a => a.Result == "Success")</div>
                    <div class="stat-label">Thành công</div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fas fa-times-circle"></i>
                    </div>
                    <div class="stat-number">@Model.FaceAuthHistory.Count(a => a.Result == "Failed")</div>
                    <div class="stat-label">Thất bại</div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fas fa-percentage"></i>
                    </div>
                    <div class="stat-number">
                        @{
                            var total = Model.FaceAuthHistory.Count();
                            var success = Model.FaceAuthHistory.Count(a => a.Result == "Success");
                            var rate = total > 0 ? Math.Round((double)success / total * 100, 1) : 0;
                        }
                        @rate%
                    </div>
                    <div class="stat-label">Tỷ lệ thành công</div>
                </div>
            </div>

            <!-- Tab Navigation -->
            <div class="tab-navigation">
                <ul class="nav nav-tabs" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active" id="auth-history-tab" data-toggle="tab" href="#auth-history" role="tab">
                            <i class="fas fa-history"></i>
                            Lịch sử xác thực
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="face-data-tab" data-toggle="tab" href="#face-data" role="tab">
                            <i class="fas fa-images"></i>
                            Dữ liệu khuôn mặt
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Authentication History Tab -->
            <div class="tab-content active" id="auth-history">
                <div class="table-card">
                    <div class="table-header">
                        <h3 class="table-title">
                            <i class="fas fa-table"></i> Lịch sử xác thực khuôn mặt
                        </h3>
                    </div>

                    <table id="faceAuthTable" class="custom-table" style="width:100%">
                        <thead>
                            <tr>
                                <th><i class="fas fa-hashtag"></i> User ID</th>
                                <th><i class="fas fa-user"></i> Username</th>
                                <th><i class="fas fa-clock"></i> Thời gian xác thực</th>
                                <th><i class="fas fa-info-circle"></i> Trạng thái</th>
                                <th><i class="fas fa-cogs"></i> Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var auth in Model.FaceAuthHistory)
                            {
                                // Define badge class based on auth status
                                string badgeClass;
                                string statusText;
                                string statusIcon;

                                switch (auth.Result)
                                {
                                    case "Success":
                                        badgeClass = "status-success";
                                        statusText = "Thành công";
                                        statusIcon = "fas fa-check";
                                        break;
                                    case "Failed":
                                        badgeClass = "status-failed";
                                        statusText = "Thất bại";
                                        statusIcon = "fas fa-times";
                                        break;
                                    default:
                                        badgeClass = "status-unknown";
                                        statusText = "Không xác định";
                                        statusIcon = "fas fa-question";
                                        break;
                                }

                                <tr>
                                    <td>
                                        <span class="user-id">#@auth.UserID</span>
                                    </td>
                                    <td>
                                        <span class="username">@auth.User.UserName</span>
                                    </td>
                                    <td>
                                        <span class="auth-time">@auth.AttemptTime.ToString("dd/MM/yyyy HH:mm:ss")</span>
                                    </td>
                                    <td>
                                        <span class="status-badge @badgeClass">
                                            <i class="@statusIcon"></i>
                                            @statusText
                                        </span>
                                    </td>
                                    <td>
                                        <a href="@Url.Action("FaceAuthDetail", "Admin", new { id = auth.Id })" class="btn-view-details">
                                            <i class="fas fa-eye"></i>
                                            Xem chi tiết
                                        </a>
                                    </td>
                                </tr>

                            }
                        </tbody>
                    </table>
                </div>
            </div>
            
            <!-- Face Data Tab -->
            <div class="tab-content" id="face-data">
                <div class="table-card">
                    <div class="table-header">
                        <h3 class="table-title">
                            <i class="fas fa-images"></i> Dữ liệu khuôn mặt
                        </h3>
                        <a id="add-face-btn" class="btn-add-face">
                            <i class="fas fa-plus"></i>
                            Thêm dữ liệu khuôn mặt
                        </a>
                    </div>
                    <div id="popup-wrapper1" class="popup-overlay" style="display: none;">
                        <div id="popup-content" class="popup-content">
                            <div class="auth-card" id="input-select">
                                <select name="name" id="userId" class="form-select">
                                    <option value="">-- Chọn tên --</option>
                                    @foreach (var user in Model.User)
                                    {
                                        <option value="@user.UserID">@user.UserName</option>
                                    }
                                </select>
                                <button id="success" class="btn btn-secondary">Xác nhận</button>
                            </div>
                            <div id="inner-wrapper">

                            </div>
                        </div>
                    </div>
                    <table id="faceDataTable" class="custom-table" style="width:100%">
                        <thead>
                            <tr>
                                <th><i class="fas fa-hashtag"></i> ID</th>
                                <th><i class="fas fa-user"></i> Tên người dùng</th>
                                <th><i class="fas fa-calendar"></i> Ngày tạo</th>
                                <th><i class="fas fa-cogs"></i> Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="faceDataTableBody">
                            @foreach(var face in Model.FaceData ){
                            <tr>
                                <td>
                                    <span class="user-id">#@face.Id</span>
                                    <input id="userId1" type="hidden" class="face-image-src" value="@face.UserID" />
                                </td>
                                <td>
                                    <span class="username">@face.User.UserName</span>
                                </td>
                                <td>
                                    <span class="auth-time">@face.CreatedAt</span>
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <a onclick="RegisterFace()" class="btn-view-details">
                                            <i class="fa-solid fa-camera"></i>
                                            Chụp lại
                                        </a>
                                        <button type="button" class="btn-remove-face" onclick="removeFaceData(@face.UserID)">
                                            <i class="fas fa-trash"></i>
                                            Xóa
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- Image Modal -->
<div class="modal fade" id="imageModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header" style="background: #4caf50; color: white;">
                <h5 class="modal-title">
                    <i class="fas fa-image"></i> Xem ảnh khuôn mặt
                </h5>
                <button type="button" class="close" data-dismiss="modal" style="color: white;">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body text-center">
                <img id="modalImage" src="/placeholder.svg" alt="Face Image" style="max-width: 100%; height: auto; border-radius: 8px;">
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            // Initialize DataTable for Authentication History
            $('#faceAuthTable').DataTable({
                language: {
                    emptyTable: "Không có dữ liệu nào trong bảng",
                    search: "🔍 Tìm kiếm:",
                    lengthMenu: "Hiển thị <b>_MENU_</b> mục",
                    info: "Hiển thị <b>_START_</b> đến <b>_END_</b> của <b>_TOTAL_</b> bản ghi",
                    infoEmpty: "Hiển thị <b>0</b> đến <b>0</b> của <b>0</b> bản ghi",
                    infoFiltered: "(được lọc từ <b>_MAX_</b> bản ghi)",
                    zeroRecords: "Không tìm thấy kết quả nào phù hợp",
                    paginate: {
                        first: "⏮️ Đầu",
                        last: "⏭️ Cuối",
                        next: "▶️ Tiếp",
                        previous: "◀️ Trước"
                    }
                },
                paging: true,
                pageLength: 10,
                lengthChange: false,
                order: [[2, 'desc']]
            });

            // Initialize DataTable for Face Data
            $('#faceDataTable').DataTable({
                language: {
                    emptyTable: "Không có dữ liệu nào trong bảng",
                    search: "🔍 Tìm kiếm:",
                    lengthMenu: "Hiển thị <b>_MENU_</b> mục",
                    info: "Hiển thị <b>_START_</b> đến <b>_END_</b> của <b>_TOTAL_</b> bản ghi",
                    infoEmpty: "Hiển thị <b>0</b> đến <b>0</b> của <b>0</b> bản ghi",
                    infoFiltered: "(được lọc từ <b>_MAX_</b> bản ghi)",
                    zeroRecords: "Không tìm thấy kết quả nào phù hợp",
                    paginate: {
                        first: "⏮️ Đầu",
                        last: "⏭️ Cuối",
                        next: "▶️ Tiếp",
                        previous: "◀️ Trước"
                    }
                },
                paging: true,
                pageLength: 10,
                lengthChange: false,
                order: [[3, 'desc']]
            });

            // Tab switching functionality
            $('.nav-link').on('click', function(e) {
                e.preventDefault();

                // Remove active class from all tabs and content
                $('.nav-link').removeClass('active');
                $('.tab-content').removeClass('active');

                // Add active class to clicked tab
                $(this).addClass('active');

                // Show corresponding content
                var target = $(this).attr('href');
                $(target).addClass('active');
            });

            // Add animation to stat cards
            $('.stat-card').each(function(index) {
                $(this).css('animation-delay', (index * 0.1) + 's');
            });
        });

        // Function to view face image in modal
        function viewFaceImage(imageSrc) {
            $('#modalImage').attr('src', imageSrc);
            $('#imageModal').modal('show');
        }

        // Function to remove face data
        function removeFaceData(id) {
            if (confirm('🗑️ Bạn có chắc chắn muốn xóa dữ liệu khuôn mặt này?\n\nHành động này không thể hoàn tác!')) {
                $.ajax({
                    url: '/Auth/RemoveFaceData/' + id,
                    type: 'DELETE',
                    success: function(response) {
                        if (response.success) {
                            alert('✅ Xóa dữ liệu khuôn mặt thành công!');
                            $('#faceDataTable').DataTable().ajax.reload();
                        } else {
                            alert('❌ ' + response.message);
                        }
                    },
                    error: function() {
                        alert('❌ Có lỗi xảy ra, vui lòng thử lại.');
                    }
                });
            }
        }
        const input = document.getElementById('input-select');

        const container1 = document.getElementById('popup-wrapper1');

        document.getElementById('add-face-btn').addEventListener('click', function () { 
            input.style.display = 'block';
            container1.style.display = container1.style.display === 'none' ? 'block' : 'none';

            document.getElementById("inner-wrapper").innerHTML="";

        });



        document.getElementById("success").addEventListener("click", function () {
            var selectedId = document.getElementById("userId").value;
            if (!selectedId) {
                alert("Vui lòng chọn người dùng.");
                return;
            }
            input.style.display = 'none';

            fetch(`/Auth/RegisterFace?userId=${selectedId}`)
                .then(response => response.text())
                .then(html => {
                    document.getElementById("inner-wrapper").innerHTML += html;
                    if (typeof initRegisterFace === "function") {
                        initRegisterFace(selectedId);
                    }
                })
                .catch(error => {
                    console.error("Lỗi khi load partial:", error);
                });
        });
        function RegisterFace(){
            var selectedId1 = document.getElementById("userId1").value;
            if (!selectedId1) {
                alert("Vui lòng chọn người dùng.");
                return;
            }
            container1.style.display = container1.style.display === 'none' ? 'block' : 'none';
            input.style.display = 'none';
            fetch(`/Auth/RegisterFace?userId=${selectedId1}`)
                .then(response => response.text())
                .then(html => {
                    document.getElementById("inner-wrapper").innerHTML += html;
                    if (typeof initRegisterFace === "function") {
                        initRegisterFace(selectedId1);
                    }
                })
                .catch(error => {
                    console.error("Lỗi khi load partial:", error);
                });
        
        }
        
    </script>
	<script src="~/js/auth/faceRegister.js"></script>
