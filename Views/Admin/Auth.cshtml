@model IEnumerable<BachHoaXanh.Models.FaceAuthHistory>
@{
    ViewData["Title"] = "Danh sách xác thực khuôn mặt";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .badge {
        padding: 0.5em;
        font-size: 1em;
        border-radius: 0.25em;
        color: white;
    }

    .badge-success {
        background-color: #28a745;
    }

    .badge-danger {
        background-color: #dc3545;
    }

    .badge-secondary {
        background-color: #6c757d;
    }
</style>

<div class="main-panel">
    <nav class="navbar navbar-default navbar-fixed">
        <div class="container-fluid">
            <div class="navbar-header">
                <a class="navbar-brand" href="#">Quản lý xác thực khuôn mặt</a>
            </div>
            <div class="collapse navbar-collapse">
                <ul class="nav navbar-nav navbar-right">
                    <li>
                        <a href="@Url.Action("Logout", "User")">
                            <p>Đăng xuất tài khoản</p>
                        </a>
                    </li>
                    <li class="separator hidden-lg"></li>
                </ul>
            </div>
        </div>
    </nav>
    <div class="table-container">
        <table id="faceAuthTable" class="table mt-3" style="width:100%">
            <thead>
                <tr>
                    <th>User ID</th>
                    <th>Username</th>
                    <th>Thời gian xác thực</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var auth in Model)
                {
                    // Define badge class based on auth status
                    string badgeClass;
                    string statusText;

                    switch (auth.Result)
                    {
                        case "Success":
                            badgeClass = "badge-success";
                            statusText = "Thành công";
                            break;
                        case "Failed":
                            badgeClass = "badge-danger";
                            statusText = "Thất bại";
                            break;
                        default:
                            badgeClass = "badge-secondary";
                            statusText = "Không xác định";
                            break;
                    }

                    <tr>
                        <td>@auth.UserID</td>
                        <td>@auth.User.UserName</td>
                        <td>@auth.AttemptTime</td>
                        <td>
                            <span class="badge @badgeClass">@statusText</span>
                        </td>
                        <td>
                            <a href="@Url.Action("FaceAuthDetail", "Admin", new { id = auth.Id })" class="btn btn-secondary mr-2 view-details-btn">Xem chi tiết</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @section scripts {
        <script>
            $(document).ready(function () {
                $('#faceAuthTable').DataTable({
                    language: {
                        emptyTable: "Không có dữ liệu nào trong bảng",
                        search: "Tìm kiếm:",
                        lengthMenu: "Hiển thị <b>_MENU_</b> mục",
                        info: "Hiển thị <b>_START_</b> đến <b>_END_</b> của <b>_TOTAL_</b> bản ghi",
                        infoEmpty: "Hiển thị <b>0</b> đến <b>0</b> của <b>0</b> bản ghi",
                        infoFiltered: "(được lọc từ <b>_MAX_</b> bản ghi)",
                        zeroRecords: "Không tìm thấy kết quả nào phù hợp",
                        paginate: {
                            first: "Đầu",
                            last: "Cuối",
                            next: "Tiếp",
                            previous: "Trước"
                        }
                    },
                    paging: true,
                    pageLength: 10,
                    lengthChange: false,
                });
            });
        </script>
    }
</div>