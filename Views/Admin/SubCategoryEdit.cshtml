@model BachHoaXanh.Models.SubCategory

@{
    ViewData["Title"] = "Sửa danh mục con";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="main-panel">
    <div class="content">
        <div class="container-fluid">
            <div class="card center-block" style="max-width: 60%;">
                <div class="header">
                    <h4 class="title">Sửa danh mục <b>#@Model.SubCategoryID</b></h4>
                </div>
                <div class="content">
                    <form asp-action="SubCategoryEdit" method="post">
                        <div class="form-group">
                            <label asp-for="SubCategoryName" class="control-label">Tên danh mục con</label>
                            <input asp-for="SubCategoryName" class="form-control" />
                            <span asp-validation-for="SubCategoryName" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="CategoryID" class="control-label">Danh mục</label>
                            <select asp-for="CategoryID" asp-items="ViewBag.CategoryList" class="form-control">
                                <option value="">-- Chọn danh mục --</option>
                            </select>
                            <span asp-validation-for="CategoryID" class="text-danger"></span>
                        </div>

                        <input type="hidden" asp-for="SubCategoryID" />

                        <button type="submit" class="btn btn-info btn-fill pull-right">Lưu thay đổi</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
