@model BachHoaXanh.Models.Product

@{
    ViewData["Title"] = "Cập nhật sản phẩm";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .main-panel {
        padding: 20px;
        background: #f4f3ef;
    }

    .container {
        max-width: 800px;
        margin: 0 auto;
        background: white;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .table-bordered {
        margin-top: 10px;
    }

    .btn {
        margin-right: 10px;
    }

    h2 {
        color: #333;
        margin-bottom: 20px;
    }

    .expired-stock {
        background-color: #ffe6e6;
        border-left: 4px solid #dc3545;
    }

    .loading-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    .loading-spinner {
        color: white;
        font-size: 1.5rem;
        text-align: center;
    }

    .image-container {
        display: flex;
        flex-wrap: nowrap;
        overflow-x: auto;
        gap: 20px;
        padding-bottom: 10px;
    }

    .image-item {
        flex: 0 0 auto;
        position: relative;
        text-align: center;
    }

        .image-item img {
            width: 150px;
            height: 150px;
            object-fit: cover;
            border: 1px solid #ddd;
            border-radius: 5px;
        }

    .remove-btn {
        position: absolute;
        top: 5px;
        right: 5px;
        background: rgba(255, 0, 0, 0.8);
        color: white;
        border: none;
        border-radius: 50%;
        width: 20px;
        height: 20px;
        font-size: 14px;
        line-height: 20px;
        text-align: center;
        cursor: pointer;
        display: none;
    }

    .image-item:hover .remove-btn {
        display: block;
    }

    .remove-btn:hover {
        background: rgba(255, 0, 0, 1);
    }

    .main-image-radio {
        margin-top: 5px;
    }
</style>

<div class="main-panel">
    <div class="loading-overlay" id="loadingOverlay">
        <div class="loading-spinner">
            <i class="fa fa-spinner fa-spin"></i> Đang xử lý...
        </div>
    </div>

    <h2>Cập nhật sản phẩm <b>#@Model.ProductID</b></h2>
    <div class="container">
        <form asp-action="ProductEdit" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="ProductID" />

            <div class="form-group">
                <label asp-for="ProductID" class="control-label">Mã sản phẩm</label>
                <input asp-for="ProductID" class="form-control" readonly />
                <span asp-validation-for="ProductID" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ProductName" class="control-label">Tên sản phẩm</label>
                <input asp-for="ProductName" class="form-control" />
                <span asp-validation-for="ProductName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="control-label">Mô tả</label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Price" class="control-label">Giá</label>
                <input asp-for="Price" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="SubCategoryID" class="control-label">Danh mục phụ</label>
                <select asp-for="SubCategoryID" asp-items="ViewBag.SubCategoryList" class="form-control">
                    <option value="">-- Chọn danh mục phụ --</option>
                </select>
                <span asp-validation-for="SubCategoryID" class="text-danger"></span>
            </div>

            <!-- Stock List -->
            <div class="form-group">
                <label>Tồn kho</label>
                <p>Tổng số lượng tồn kho: <b>@Model.StockQuantity</b></p>
                @if (Model.Stocks.Any())
                {
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Ngày hết hạn</th>
                                <th>Số lượng</th>
                                <th>Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var stock in Model.Stocks)
                            {
                                <tr class="@(stock.ExpirationDate < DateTime.Now ? "expired-stock" : "")">
                                    <td>
                                        @(stock.ExpirationDate == DateTime.MaxValue ? "Không có" : stock.ExpirationDate.ToString("dd/MM/yyyy"))
                                        @(stock.ExpirationDate < DateTime.Now ? " (Hết hạn)" : "")
                                    </td>
                                    <td>@stock.Quantity</td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-warning edit-stock" data-stock-id="@stock.StockID" data-quantity="@stock.Quantity" data-expiration="@(stock.ExpirationDate == DateTime.MaxValue ? "" : stock.ExpirationDate.ToString("yyyy-MM-dd"))">Sửa</button>
                                        <button type="button" class="btn btn-sm btn-danger delete-stock" data-stock-id="@stock.StockID">Xóa</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p>Chưa có thông tin tồn kho.</p>
                }
            </div>

            <!-- Add New Stock -->
            <div class="form-group">
                <label>Thêm tồn kho mới</label>
                <div class="row">
                    <div class="col-md-6">
                        <label>Số lượng</label>
                        <input type="number" name="newStockQuantities" class="form-control" min="0" placeholder="Nhập số lượng" />
                        <small class="form-text text-muted">Nhập số lượng lớn hơn 0 để thêm tồn kho.</small>
                    </div>
                    <div class="col-md-6">
                        <label>Ngày hết hạn</label>
                        <input type="date" name="newStockExpirationDates" class="form-control" />
                        <small class="form-text text-muted">Để trống nếu không có ngày hết hạn.</small>
                    </div>
                </div>
            </div>

            <!-- Image Section -->
            <div class="form-group">
                <label>Hình ảnh hiện tại</label><br />
                @if (Model.Images != null && Model.Images.Any())
                {
                    <div class="image-container">
                        @foreach (var image in Model.Images)
                        {
                            <div class="image-item">
                                <img src="~/images/@image.ImagePath" alt="Product Image" data-image-id="@image.ImageID" />
                                <button class="remove-btn" data-image-id="@image.ImageID">X</button>
                                <div class="main-image-radio">
                                    <label>
                                        <input type="radio" name="mainImage" value="@image.ImageID" @(image.IsMainImage ? "checked" : "") />
                                        Hình ảnh chính
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p>Chưa có hình ảnh.</p>
                }
            </div>

            <div class="form-group">
                <label>Thêm hình ảnh mới</label>
                <input type="file" name="imageFile" class="form-control" onchange="previewImage(event)" />
                <img id="preview" style="display: none; width: 150px; height: 150px; object-fit: cover; margin-top: 10px;" />
            </div>

            <div class="form-group">
                <input type="submit" value="Cập nhật" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewImage(event) {
            var preview = document.getElementById('preview');
            preview.src = URL.createObjectURL(event.target.files[0]);
            preview.style.display = 'block';
        }

        function showLoadingOverlay() {
            $('#loadingOverlay').fadeIn(300);
        }

        function hideLoadingOverlay() {
            $('#loadingOverlay').fadeOut(300);
        }

        document.querySelectorAll('.edit-stock').forEach(button => {
            button.addEventListener('click', function () {
                const stockId = this.getAttribute('data-stock-id');
                const quantity = this.getAttribute('data-quantity');
                const expiration = this.getAttribute('data-expiration');

                const newQuantity = prompt(`Sửa tồn kho ID: ${stockId}\nNhập số lượng mới:`, quantity);
                const newExpiration = prompt(`Nhập ngày hết hạn mới (YYYY-MM-DD):`, expiration);

                if (newQuantity !== null && newExpiration !== null) {
                    showLoadingOverlay();
                    $.ajax({
                        url: `/api/stocks/${stockId}`,
                        type: 'PUT',
                        contentType: 'application/json',
                        data: JSON.stringify({
                            StockID: stockId,
                            Quantity: parseInt(newQuantity),
                            ExpirationDate: newExpiration || "9999-12-31"
                        }),
                        success: function () {
                            alert('Cập nhật tồn kho thành công!');
                            location.reload();
                        },
                        error: function (xhr, status, error) {
                            console.log('AJAX Error:', status, error);
                            alert('Có lỗi xảy ra khi cập nhật tồn kho. Kiểm tra console để biết thêm chi tiết.');
                        },
                        complete: function () {
                            hideLoadingOverlay();
                        }
                    });
                }
            });
        });

        document.querySelectorAll('.delete-stock').forEach(button => {
            button.addEventListener('click', function () {
                const stockId = this.getAttribute('data-stock-id');
                if (confirm(`Bạn có chắc muốn xóa tồn kho ID: ${stockId}?`)) {
                    showLoadingOverlay();
                    $.ajax({
                        url: `/api/stocks/${stockId}`,
                        type: 'DELETE',
                        success: function () {
                            alert('Xóa tồn kho thành công!');
                            location.reload();
                        },
                        error: function (xhr, status, error) {
                            console.log('AJAX Error:', status, error);
                            alert('Có lỗi xảy ra khi xóa tồn kho. Kiểm tra console để biết thêm chi tiết.');
                        },
                        complete: function () {
                            hideLoadingOverlay();
                        }
                    });
                }
            });
        });

        document.querySelectorAll('.remove-btn').forEach(button => {
            button.addEventListener('click', function () {
                const imageId = this.getAttribute('data-image-id');
                if (confirm(`Bạn có chắc muốn xóa hình ảnh ID: ${imageId}?`)) {
                    showLoadingOverlay();
                    $.ajax({
                        url: `/api/images/${imageId}`,
                        type: 'DELETE',
                        success: function () {
                            alert('Xóa hình ảnh thành công!');
                            location.reload();
                        },
                        error: function (xhr, status, error) {
                            console.log('AJAX Error:', status, error);
                            alert('Có lỗi xảy ra khi xóa hình ảnh. Kiểm tra console để biết thêm chi tiết.');
                        },
                        complete: function () {
                            hideLoadingOverlay();
                        }
                    });
                }
            });
        });
    </script>
}