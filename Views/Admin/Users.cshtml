@model IEnumerable<BachHoaXanh.Models.User>
@{
    ViewData["Title"] = "Danh sách người dùng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="main-panel">
    <nav class="navbar navbar-default navbar-fixed">
        <div class="container-fluid">
            <div class="navbar-header">
                <a class="navbar-brand" href="#">Quản lý người dùng</a>
            </div>
            <div class="collapse navbar-collapse">
                <ul class="nav navbar-nav navbar-right">
                    <li>
                        <a href="@Url.Action("Logout","User")">
                            <p>Đăng xuất tài khoản</p>
                        </a>
                    </li>
                    <li class="separator hidden-lg"></li>
                </ul>
            </div>
        </div>
    </nav>
    <div class="table-container">
        <a href="@Url.Action("UserAdd", "Admin")" type="submit" class="btn btn-info btn-fill pull-left" style="margin-bottom: 10px;">Thêm tài khoản mới</a>
        <table id="productTable" class="table mt-3" style="width:100%">
            <thead>
                <tr class="">
                    <th>#ID</th>
                    <th>UserName</th>
                    <th>Họ & Tên</th>
                    <th>Email</th>
                    <th>Số điện thoại</th>
                    <th>Quyền</th>
                    <th>Điểm tích lũy</th>
                    <th>Rank</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.UserID</td>
                        <td>@user.UserName</td>
                        <td>@user.FullName</td>
                        <td>@user.Email</td>
                        <td>@user.Phone</td>
                        <td>@user.Role</td>
                        <td>@user.Points</td>
                        <td>@user.Rank</td>
                        <td>
                            <a href="@Url.Action("UserEdit", "Admin", new { userName = user.UserName })" class="btn btn-success btn-xs dt-edit" style="margin-right:16px;">
                                <i class="fa-regular fa-pen-to-square"></i>
                            </a>
                            <button type="button" class="btn btn-danger btn-xs dt-delete" onclick="deleteUser('@user.UserName')">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @section scripts {
        <script>
            $(document).ready(function () {
                $('#productTable').DataTable({
                    language: {
                        emptyTable: "Không có dữ liệu nào trong bảng",
                        search: "Tìm kiếm:",
                        lengthMenu: "Hiển thị <b>_MENU_</b> mục",
                        info: "Hiển thị <b>_START_</b> đến <b>_END_</b> của <b>_TOTAL_ sản phẩm</b>",
                        infoEmpty: "Hiển thị <b>0</b> đến <b>0</b> của <b>0</b> sản phẩm",
                        infoFiltered: "(được lọc từ <b>_MAX_</b> sản phẩm)",
                        zeroRecords: "Không tìm thấy kết quả nào phù hợp",
                        paginate: {
                            first: "Đầu",
                            last: "Cuối",
                            next: "Tiếp",
                            previous: "Trước"
                        }
                    },
                    paging: true,
                    pageLength: 10,
                    lengthChange: false,
                });
            });

            function deleteUser(username) {
                if (confirm("Bạn có chắc chắn muốn xóa tài khoản này?")) {
                    $.ajax({
                        url: `/api/user/${username}`,
                        type: 'DELETE',
                        success: function () {
                            location.reload();
                        },
                        error: function () {
                            alert("Có lỗi xảy ra, vui lòng thử lại.");
                        }
                    });
                }
            }
        </script>
    }
