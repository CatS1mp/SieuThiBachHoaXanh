@model IEnumerable<BachHoaXanh.Models.Order>
@{
    ViewData["Title"] = "Danh sách đơn hàng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .admin-container {
        background: linear-gradient(135deg, #f0f9f0 0%, #e8f5e8 100%);
        min-height: 100vh;
        padding: 0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .main-panel {
        background: transparent;
        padding: 0;
    }

    .admin-navbar {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border: none;
        box-shadow: 0 2px 20px rgba(76, 175, 80, 0.1);
        border-radius: 0 0 15px 15px;
        margin-bottom: 2rem;
        border-bottom: 3px solid #4caf50;
    }

    .navbar-brand {
        color: #2e7d32 !important;
        font-size: 1.5rem;
        font-weight: 700;
    }

    .navbar-nav a {
        color: #2e7d32 !important;
        font-weight: 600;
    }

    .content-wrapper {
        padding: 2rem;
        max-width: 1400px;
        margin: 0 auto;
    }

    .stats-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .stat-card {
        background: white;
        border-radius: 12px;
        padding: 1.5rem;
        text-align: center;
        box-shadow: 0 4px 20px rgba(76, 175, 80, 0.1);
        border: 2px solid #e8f5e8;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #4caf50, #66bb6a);
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 30px rgba(76, 175, 80, 0.2);
            border-color: #4caf50;
        }

    .stat-icon {
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
        color: #4caf50;
    }

    .stat-number {
        font-size: 2rem;
        font-weight: 700;
        color: #2e7d32;
        margin-bottom: 0.25rem;
    }

    .stat-label {
        color: #666;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .table-card {
        background: white;
        border-radius: 15px;
        padding: 2rem;
        box-shadow: 0 4px 20px rgba(76, 175, 80, 0.1);
        border: 2px solid #e8f5e8;
    }

    .table-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        gap: 1rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #f1f8e9;
    }

    .table-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #2e7d32;
        margin: 0;
    }

    .custom-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        background: white;
        border-radius: 8px;
        overflow: hidden;
    }

        .custom-table thead th {
            background: #4caf50;
            color: white;
            padding: 1rem;
            font-weight: 600;
            text-align: left;
            border: none;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .custom-table tbody tr {
            transition: all 0.3s ease;
            border-bottom: 1px solid #f1f8e9;
        }

            .custom-table tbody tr:hover {
                background: #f8fdf8;
            }

            .custom-table tbody tr:nth-child(even) {
                background: #fafffe;
            }

                .custom-table tbody tr:nth-child(even):hover {
                    background: #f1f8e9;
                }

        .custom-table tbody td {
            padding: 1rem;
            vertical-align: middle;
            border: none;
            color: #333;
        }

    .order-id {
        font-weight: 700;
        color: #2e7d32;
        background: #f1f8e9;
        padding: 4px 8px;
        border-radius: 6px;
        display: inline-block;
    }

    .order-date {
        font-weight: 600;
        color: #666;
    }

    .customer-name {
        font-weight: 600;
        color: #2e7d32;
    }

    .payment-method {
        background: #f1f8e9;
        color: #2e7d32;
        padding: 4px 8px;
        border-radius: 6px;
        font-size: 0.9rem;
        font-weight: 500;
    }

    .status-badge {
        padding: 6px 12px;
        border-radius: 15px;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border: 2px solid;
    }

    .status-pending {
        background: #fff8e1;
        color: #f57c00;
        border-color: #ffb74d;
    }

    .status-processing {
        background: #e3f2fd;
        color: #1976d2;
        border-color: #64b5f6;
    }

    .status-shipping {
        background: #f3e5f5;
        color: #7b1fa2;
        border-color: #ba68c8;
    }

    .status-completed {
        background: #e8f5e8;
        color: #2e7d32;
        border-color: #4caf50;
    }

    .status-cancelled {
        background: #ffebee;
        color: #c62828;
        border-color: #f44336;
    }

    .status-unknown {
        background: #f5f5f5;
        color: #616161;
        border-color: #9e9e9e;
    }

    .btn-view-details {
        background: #4caf50;
        border: none;
        color: white;
        padding: 8px 16px;
        border-radius: 6px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.3s ease;
        font-size: 0.9rem;
    }

        .btn-view-details:hover {
            background: #45a049;
            transform: translateY(-1px);
            color: white;
            text-decoration: none;
        }

    .dataTables_wrapper {
        margin-top: 1rem;
    }

    .dataTables_filter {
        margin-bottom: 1rem;
    }

        .dataTables_filter label {
            color: #2e7d32;
            font-weight: 600;
        }

        .dataTables_filter input {
            border: 2px solid #e8f5e8;
            border-radius: 8px;
            padding: 8px 16px;
            margin-left: 8px;
            transition: border-color 0.3s ease;
        }

            .dataTables_filter input:focus {
                border-color: #4caf50;
                outline: none;
                box-shadow: 0 0 0 3px rgba(76, 175, 80, 0.1);
            }

    .dataTables_info {
        color: #666;
        font-weight: 500;
    }

    .dataTables_paginate .paginate_button {
        border-radius: 6px !important;
        margin: 0 2px !important;
        border: 2px solid #e8f5e8 !important;
        background: white !important;
        color: #4caf50 !important;
        font-weight: 600 !important;
    }

        .dataTables_paginate .paginate_button:hover {
            background: #4caf50 !important;
            color: white !important;
            border-color: #4caf50 !important;
        }

        .dataTables_paginate .paginate_button.current {
            background: #4caf50 !important;
            color: white !important;
            border-color: #4caf50 !important;
        }

    @@media (max-width: 768px) {
        .content-wrapper

    {
        padding: 1rem;
    }

    .table-header {
        flex-direction: column;
        align-items: stretch;
    }

    .custom-table {
        font-size: 0.8rem;
    }

        .custom-table thead th,
        .custom-table tbody td {
            padding: 0.5rem;
        }

    }
</style>

<div class="admin-container">
    <div class="main-panel">
        <nav class="navbar admin-navbar">
            <div class="container-fluid">
                <div class="navbar-header">
                    <a class="navbar-brand" href="#">
                        <i class="fas fa-shopping-cart"></i> Quản lý đơn hàng
                    </a>
                </div>
                <div class="collapse navbar-collapse">
                    <ul class="nav navbar-nav navbar-right">
                        <li>
                            <a href="@Url.Action("Logout","User")">
                                <i class="fas fa-sign-out-alt"></i> Đăng xuất tài khoản
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <div class="content-wrapper">
            <!-- Stats Cards -->
            <div class="stats-cards">
                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fas fa-shopping-cart"></i>
                    </div>
                    <div class="stat-number">@Model.Count()</div>
                    <div class="stat-label">Tổng đơn hàng</div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fas fa-clock"></i>
                    </div>
                    <div class="stat-number">@Model.Count(o => o.OrderStatus == "Pending")</div>
                    <div class="stat-label">Chờ xử lý</div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <div class="stat-number">@Model.Count(o => o.OrderStatus == "Completed")</div>
                    <div class="stat-label">Hoàn thành</div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fas fa-times-circle"></i>
                    </div>
                    <div class="stat-number">@Model.Count(o => o.OrderStatus == "Cancelled")</div>
                    <div class="stat-label">Đã hủy</div>
                </div>
            </div>

            <!-- Table Card -->
            <div class="table-card">
                <div class="table-header">
                    <h3 class="table-title">
                        <i class="fas fa-table"></i> Danh sách đơn hàng
                    </h3>
                </div>

                <table id="productTable" class="custom-table" style="width:100%">
                    <thead>
                        <tr>
                            <th><i class="fas fa-hashtag"></i> ID</th>
                            <th><i class="fas fa-calendar"></i> Ngày tạo</th>
                            <th><i class="fas fa-user"></i> Khách hàng</th>
                            <th><i class="fas fa-credit-card"></i> Phương thức thanh toán</th>
                            <th><i class="fas fa-info-circle"></i> Trạng thái</th>
                            <th><i class="fas fa-cogs"></i> Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            // Define badge class based on order status
                            string badgeClass;
                            string statusText;

                            switch (order.OrderStatus)
                            {
                                case "Pending":
                                    badgeClass = "status-pending";
                                    statusText = "Chờ xử lý";
                                    break;
                                case "Processing":
                                    badgeClass = "status-processing";
                                    statusText = "Đang xử lý";
                                    break;
                                case "Shipping":
                                    badgeClass = "status-shipping";
                                    statusText = "Đang giao";
                                    break;
                                case "Completed":
                                    badgeClass = "status-completed";
                                    statusText = "Hoàn thành";
                                    break;
                                case "Cancelled":
                                    badgeClass = "status-cancelled";
                                    statusText = "Đã hủy";
                                    break;
                                default:
                                    badgeClass = "status-unknown";
                                    statusText = "Không xác định";
                                    break;
                            }

                            <tr>
                                <td>
                                    <span class="order-id">#@order.OrderID</span>
                                </td>
                                <td>
                                    <span class="order-date">@order.CreatedAt.ToString("dd/MM/yyyy")</span>
                                </td>
                                <td>
                                    <span class="customer-name">@order.User.FullName</span>
                                </td>
                                <td>
                                    <span class="payment-method">
                                        <i class="fas fa-credit-card"></i> @order.PaymentMethod.MethodName
                                    </span>
                                </td>
                                <td>
                                    <span class="status-badge @badgeClass">@statusText</span>
                                </td>
                                <td>
                                    <a href="@Url.Action("OrderDetail", "Admin", new { id = order.OrderID })" class="btn-view-details">
                                        <i class="fas fa-eye"></i>
                                        Xem chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            $('#productTable').DataTable({
                language: {
                    emptyTable: "Không có dữ liệu nào trong bảng",
                    search: "🔍 Tìm kiếm:",
                    lengthMenu: "Hiển thị <b>_MENU_</b> mục",
                    info: "Hiển thị <b>_START_</b> đến <b>_END_</b> của <b>_TOTAL_</b> đơn hàng",
                    infoEmpty: "Hiển thị <b>0</b> đến <b>0</b> của <b>0</b> đơn hàng",
                    infoFiltered: "(được lọc từ <b>_MAX_</b> đơn hàng)",
                    zeroRecords: "Không tìm thấy kết quả nào phù hợp",
                    paginate: {
                        first: "⏮️ Đầu",
                        last: "⏭️ Cuối",
                        next: "▶️ Tiếp",
                        previous: "◀️ Trước"
                    }
                },
                paging: true,
                pageLength: 10,
                lengthChange: false,
                order: [[0, 'desc']],
                columnDefs: [
                    { orderable: false, targets: -1 }
                ]
            });
        });

        $(document).on('click', '.dropdown-item', function () {
            var selectedStatus = $(this).data('status');
            $('#orderStatus').text(selectedStatus);

            var orderId = $('#orderId').text();

            $.ajax({
                url: '/api/orders/' + orderId + '/status',
                method: 'PUT',
                contentType: 'application/json',
                data: JSON.stringify({ status: selectedStatus }),
                success: function (response) {
                    $('#orderTable1').DataTable().ajax.reload();
                    viewOrderDetails(orderId);
                },
                error: function (xhr, status, error) {
                    console.error("Error updating order status:", status, error);
                    alert("❌ Không thể cập nhật trạng thái đơn hàng.");
                }
            });

            $.ajax({
                url: '/api/getorderdetails/' + orderId,
                method: 'GET',
                success: function (data) {
                    if (data) {
                        $('#orderId').text(data.orderID || 'N/A');
                        $('#orderDate').text(data.orderDate || 'N/A');
                        $('#orderTotal').text(data.total || 'N/A');
                        $('#paymentStatus').text(data.status || 'N/A');

                        const dropdownButton = $('#orderStatus');
                        const orderStatus = data.status || 'Chọn trạng thái';
                        dropdownButton.text(orderStatus);

                        if (Array.isArray(data.products) && data.products.length > 0) {
                            let productsHtml = '';
                            data.products.forEach(product => {
                                productsHtml += `
                                    <tr>
                                        <td><img src="@Url.Content("") ${product.image}" alt="Product Image" style="width: 50px; height: 50px; border-radius: 6px; border: 2px solid #e8f5e8;"></td>
                                        <td style="font-weight: 600; color: #2e7d32;">${product.productName}</td>
                                        <td style="color: #666;">${product.quantity}</td>
                                        <td style="font-weight: 600; color: #4caf50;">${product.price} × ${product.quantity} = ${product.total}</td>
                                    </tr>
                                `;
                            });
                            $('#orderProductsTable tbody').html(productsHtml);
                        } else {
                            $('#orderProductsTable tbody').html('<tr><td colspan="4" style="text-align: center; color: #666;">Không có sản phẩm nào</td></tr>');
                        }

                        $('#orderDetailModal').modal('show');
                    } else {
                        alert("❌ Dữ liệu đơn hàng không hợp lệ.");
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Error fetching order details:", status, error);
                    alert("❌ Không thể tải chi tiết đơn hàng.");
                }
            });
        });
    </script>
}