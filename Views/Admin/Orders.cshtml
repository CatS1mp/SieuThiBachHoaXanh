@model IEnumerable<BachHoaXanh.Models.Order>
@{
    ViewData["Title"] = "Danh sách đơn hàng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .badge {
        padding: 0.5em;
        font-size: 1em;
        border-radius: 0.25em;
        color: white;
    }

    .badge-warning {
        background-color: #ffc107;
    }

    .badge-info {
        background-color: #17a2b8;
    }

    .badge-primary {
        background-color: #007bff;
    }

    .badge-success {
        background-color: #28a745;
    }

    .badge-danger {
        background-color: #dc3545;
    }

    .badge-secondary {
        background-color: #6c757d;
    }
</style>

<div class="main-panel">
    <nav class="navbar navbar-default navbar-fixed">
        <div class="container-fluid">
            <div class="navbar-header">
                <a class="navbar-brand" href="#">Quản lý đơn hàng</a>
            </div>
            <div class="collapse navbar-collapse">
                <ul class="nav navbar-nav navbar-right">
                    <li>
                        <a href="@Url.Action("Logout","User")">
                            <p>Đăng xuất tài khoản</p>
                        </a>
                    </li>
                    <li class=" separator hidden-lg"></li>
                </ul>
            </div>
        </div>
    </nav>
    <div class="table-container">
        <table id="productTable" class="table mt-3" style="width:100%">
            <thead>
                <tr>
                    <th>#ID</th>
                    <th>Ngày tạo</th>
                    <th>Khách hàng</th>
                    <th>Phương thức thanh toán</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    // Define badge class based on order status
                    string badgeClass;
                    string statusText;

                    switch (order.OrderStatus)
                    {
                        case "Pending":
                            badgeClass = "badge-warning";
                            statusText = "Pending";
                            break;
                        case "Processing":
                            badgeClass = "badge-info";
                            statusText = "Processing";
                            break;
                        case "Shipping":
                            badgeClass = "badge-primary";
                            statusText = "Shipping";
                            break;
                        case "Completed":
                            badgeClass = "badge-success";
                            statusText = "Completed";
                            break;
                        case "Cancelled":
                            badgeClass = "badge-danger";
                            statusText = "Cancelled";
                            break;
                        default:
                            badgeClass = "badge-secondary";
                            statusText = "Unknown";
                            break;
                    }

                    <tr>
                        <td>@order.OrderID</td>
                        <td>@order.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td>@order.User.FullName</td>
                        <td>@order.PaymentMethod.MethodName</td>
                        <td>
                            <span class="badge @badgeClass">@statusText</span>
                        </td>
                        <td class="">
                            <a href="@Url.Action("OrderDetail", "Admin", new { id = order.OrderID })" class="btn btn-secondary mr-2 view-details-btn">Xem chi tiết</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @section scripts {
        <script>
            $(document).ready(function () {
                $('#productTable').DataTable({
                    language: {
                        emptyTable: "Không có dữ liệu nào trong bảng",
                        search: "Tìm kiếm:",
                        lengthMenu: "Hiển thị <b>_MENU_</b> mục",
                        info: "Hiển thị <b>_START_</b> đến <b>_END_</b> của <b>_TOTAL_ sản phẩm</b>",
                        infoEmpty: "Hiển thị <b>0</b> đến <b>0</b> của <b>0</b> sản phẩm",
                        infoFiltered: "(được lọc từ <b>_MAX_</b> sản phẩm)",
                        zeroRecords: "Không tìm thấy kết quả nào phù hợp",
                        paginate: {
                            first: "Đầu",
                            last: "Cuối",
                            next: "Tiếp",
                            previous: "Trước"
                        }
                    },
                    paging: true,
                    pageLength: 10,
                    lengthChange: false,
                });
            });


            $(document).on('click', '.dropdown-item', function () {
                var selectedStatus = $(this).data('status');
                $('#orderStatus').text(selectedStatus);

                var orderId = $('#orderId').text();

                $.ajax({
                    url: '/api/orders/' + orderId + '/status',
                    method: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify({ status: selectedStatus }),
                    success: function (response) {


                        $('#orderTable1').DataTable().ajax.reload();
                        viewOrderDetails(orderId);
                        // alert('Cập nhật trạng thái order thành công');
                    },
                    error: function (xhr, status, error) {
                        console.error("Error updating order status:", status, error);
                        alert("Failed to update order status.");
                    }
                });
                $.ajax({
                    url: '/api/getorderdetails/' + orderId,
                    method: 'GET',
                    success: function (data) {
                        if (data) {
                            $('#orderId').text(data.orderID || 'N/A');
                            $('#orderDate').text(data.orderDate || 'N/A');
                            $('#orderTotal').text(data.total || 'N/A');
                            $('#paymentStatus').text(data.status || 'N/A');

                            const dropdownButton = $('#orderStatus');
                            const orderStatus = data.status || 'Chọn trạng thái';
                            dropdownButton.text(orderStatus);

                            if (Array.isArray(data.products) && data.products.length > 0) {
                                let productsHtml = '';
                                data.products.forEach(product => {
                                    productsHtml += `
                                        <tr>
                                            <td><img src="@Url.Content("") ${product.image}" alt="Product Image" style="width: 50px; height: 50px;"></td>
                                            <td>${product.productName}</td>
                                            <td>${product.quantity}</td>
                                            <td>(${product.price})${product.total}</td>
                                        </tr>
                                    `;
                                });
                                $('#orderProductsTable tbody').html(productsHtml);
                            } else {
                                $('#orderProductsTable tbody').html('<tr><td colspan="4">No products available</td></tr>');
                            }

                            $('#orderDetailModal').modal('show');
                        } else {
                            alert("Invalid order data received.");
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("Error fetching order details:", status, error);
                        alert("Failed to fetch order details.");
                    }
                });
            });

        </script>
    }
