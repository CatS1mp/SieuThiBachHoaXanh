@model BachHoaXanh.Models.Order
@{
    ViewData["Title"] = "Chi tiết đơn hàng " + Model.OrderID;
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<style>

    /* ============== order_detail */

    .order-detail-container {
        margin-top: 20px;
        border-radius: 10px;
        background-color: #fff !important;
        padding: 20px;
    }

        .order-detail-container .order-info {
            margin-top: 20px;
            background-color: #f2f5f9;
            padding: 20px;
            border-radius: 10px;
        }

            .order-detail-container .order-info div {
                display: flex;
                align-items: flex-start;
                margin-bottom: 10px;
            }

            .order-detail-container .order-info strong {
                width: 140px;
                font-weight: bold;
                flex-shrink: 0;
            }

            .order-detail-container .order-info p {
                margin: 0;
                word-wrap: break-word;
            }

        .order-detail-container .order-title {
            display: flex;
            justify-content: space-between;
        }

        .order-detail-container .order-detail {
            display: flex;
            gap: 30px;
            text-align: right;
            justify-content: flex-end;
        }

    .cart-box {
        border-radius: 10px;
        padding: 10px;
        background-color: #fff;
    }

    .cart-item {
        display: flex;
        align-items: center;
        padding: 10px;
        border-bottom: 1px solid #e0e0e0;
        position: relative;
    }

    .cart-img {
        width: 80px;
        height: 80px;
        object-fit: cover;
        margin-right: 15px;
        border-radius: 8px;
    }

    .cart-name {
        flex-grow: 1;
        font-size: 16px;
        font-weight: bold;
        margin: 0 15px;
    }

    .cart-pqty-controls {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
    }

    .cart-price {
        font-size: 18px;
        font-weight: bold;
        margin-bottom: 8px;
    }

    .qtyminus,
    .qtyplus {
        width: 40px;
        height: 40px;
        background-color: #f0f0f0;
        border: none;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
        text-align: center;
        border-radius: 5px;
        margin: 2px;
    }

        .qtyminus:hover,
        .qtyplus:hover {
            background-color: #ddd;
        }

    .cart-pqty-controls input[type="number"] {
        width: 70px;
        height: 40px;
        text-align: center;
        font-size: 16px;
        border: 1px solid #ccc;
        border-radius: 5px;
        margin: 2px 0;
    }

    #orderStatus {
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 0.25rem;
        font-size: 14px;
        background-color: #fff;
        width: 100%;
        box-sizing: border-box;
    }


</style>


<div class="main-panel">
    <nav class="navbar navbar-default navbar-fixed">
        <div class="container-fluid">
            <div class="navbar-header">

                <a class="navbar-brand" href="#">Quản lý đơn hàng</a>
            </div>
            <div class="collapse navbar-collapse">
                <ul class="nav navbar-nav navbar-right">
                    <li>
                        <a href="@Url.Action("Logout","User")">
                            <p>Đăng xuất tài khoản</p>
                        </a>
                    </li>
                    <li class=" separator hidden-lg"></li>
                </ul>
            </div>
        </div>
    </nav>


    <div class="content">
        <div class="container-fluid">
            <div class="card center-block" style="max-width: 60%;">
                <div class="content">
                    <div class="order-detail-container">

                        <div style="margin-bottom: 20px;">
                            <a href="@Url.Action("Orders", "Admin")" class="btn btn-primary">Quay lại danh sách đơn hàng</a>
                        </div>
                        <div class="order-header">
                            <div class="order-title">
                                <h4>Chi tiết đơn hàng <b>#@(Model.OrderID)</b></h4>
                                <div class="order-detail">
                                    <div class="order-date">
                                        <strong><i class="fas fa-calendar-alt"></i> Ngày đặt hàng</strong>
                                        <p class="value mb-0">@Model.CreatedAt.ToString("dd/MM/yyyy - HH:mm")</p>
                                    </div>
                                    <div class="order-status">
                                        <strong><i class="fas fa-truck"></i> Trạng thái</strong>
                                        <p class="value mb-0">@Model.OrderStatus</p>
                                    </div>
                                </div>

                            </div>

                            <div class="col-12" style="margin: 0 !important; display: flex; justify-content: flex-end; align-items: center;">
                                <label for="orderStatus" class="col-form-label " style="padding-right: 15px">Trạng thái đơn hàng:</label>
                                <div class="ml-2">
                                    <select id="orderStatus" class="form-select">
                                        <option value="" disabled>Chọn trạng thái</option>
                                        <option value="Pending">Pending</option>
                                        <option value="Processing">Processing</option>
                                        <option value="Shipping">Shipping</option>
                                        <option value="Completed">Completed</option>
                                        <option value="Cancelled">Cancelled</option>
                                    </select>
                                </div>
                            </div>

                            <div class="order-info">
                                <div class="order-recipient">
                                    <strong>Người nhận:</strong>
                                    <p class="name">@Model.User.FullName, <span class="phone">@Model.User.Phone</span></p>
                                </div>
                                <div class="order-address">
                                    <strong>Địa chỉ giao hàng:</strong>
                                    <p class="value">@Model.ShippingAddress</p>
                                </div>
                                <div class="order-note">
                                    <strong>Ghi chú:</strong>
                                    <p class="value">@Model.Note</p>
                                </div>
                                <div class="order-payment">
                                    <strong>Thanh toán:</strong>
                                    <p class="value">@Model.PaymentMethod.MethodName</p>
                                </div>
                                <div class="order-total">
                                    <strong>Tổng đơn hàng:</strong>
                                    <p class="value">@Model.TotalAmount.ToString("N0")₫</p>
                                </div>
                            </div>
                        </div>

                        <div class="order-items mt-4">
                            <h5>Sản phẩm (@Model.OrderDetails.Count)</h5>
                            @foreach (var item in Model.OrderDetails)
                            {
                                var product = item.Product;
                                var productImages = product.Images;

                                <div class="cart-box">
                                    <div class="cart-item">
                                        <!-- Displaying Product Image -->
                                        <img class="cart-img" src="@(Url.Content("~/images/prods/" + (productImages.FirstOrDefault(img => img.IsMainImage)?.ImagePath ?? "default-image.png")))" alt="@product.ProductName">
                                        <p class="cart-name mb-0">@product.ProductName</p>

                                        <div class="cart-pqty-controls">
                                            <p class="cart-price mb-0">@item.UnitPrice.ToString("N0")₫</p>
                                            <p class="cart-qty mb-0">Số lượng: @item.Quantity</p>
                                        </div>
                                    </div>
                                </div>
                            }

                        </div>
                    </div>

                    <div class="clearfix"></div>
                </div>
            </div>
        </div>

    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var currentStatus = '@Model.OrderStatus';
            var orderStatusSelect = document.getElementById('orderStatus');
            if (orderStatusSelect) {
                orderStatusSelect.value = currentStatus;
            }
        });
        document.getElementById('orderStatus').addEventListener('change', function () {
            var selectedStatus = this.value;
            var orderId = '@Model.OrderID';
            $.ajax({
                url: '/Admin/UpdateOrderStatus', 
                type: 'POST',
                data: {
                    orderId: orderId,
                    status: selectedStatus
                },
                success: function (response) {
                    alert('Trạng thái đơn hàng đã được cập nhật!');
                    document.querySelector('.order-status .value').textContent = selectedStatus;
                },
                error: function () {
                    alert('Có lỗi xảy ra khi cập nhật trạng thái đơn hàng. Vui lòng thử lại.');
                }
            });
        });
    </script>
