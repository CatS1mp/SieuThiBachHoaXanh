@model BachHoaXanh.Models.User
@{
    ViewData["Title"] = "Sửa người dùng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="main-panel">
    <nav class="navbar navbar-default navbar-fixed">
        <div class="container-fluid">
            <div class="navbar-header">
                <a class="navbar-brand" href="#">Quản lý người dùng</a>
            </div>
            <div class="collapse navbar-collapse">
                <ul class="nav navbar-nav navbar-right">
                    <li>
                        <a href="@Url.Action("Logout","User")">
                            <p>Đăng xuất tài khoản</p>
                        </a>
                    </li>
                    <li class="separator hidden-lg"></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="content">
        <div class="container-fluid">
            <div class="card center-block" style="max-width: 60%;">
                <div class="header">
                    <h4 class="title">Sửa tài khoản <b>#@Model.UserName</b></h4>
                </div>
                <div class="content">
                    <form asp-action="UserEdit" method="post">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Username:</label>
                                    <input asp-for="UserName" type="text" class="form-control" name="Username" value="@Model.UserName" required readonly />
                                    <span asp-validation-for="UserName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="email">Email:</label>
                                    <input asp-for="Email" type="email" class="form-control" name="Email" value="@Model.Email" required />
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Họ & Tên</label>
                                    <input asp-for="FullName" type="text" class="form-control" name="FullName" value="@Model.FullName" required />
                                    <span asp-validation-for="FullName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Số điện thoại</label>
                                    <input asp-for="Phone" type="number" class="form-control" name="Phone" value="@Model.Phone" required />
                                    <span asp-validation-for="Phone" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label>Địa chỉ</label>
                                    <input asp-for="Address" type="text" class="form-control" name="Address" value="@Model.Address" required />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Mật khẩu</label>
                                    <input asp-for="Password" type="password" class="form-control" name="Password" required />
                                    <span asp-validation-for="Password" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Rank hiện tại</label>
                                    <input value="@Model.Rank" type="text" class="form-control" readonly />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="role">Quyền</label>
                                    <select asp-for="Role" id="role" class="form-control" name="Role">
                                        <option value="" disabled selected>Chọn quyền</option>
                                        <option value="Customer">Customer</option>
                                        <option value="Admin">Admin</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-info btn-fill pull-right">Sửa người dùng</button>
                        <div class="clearfix"></div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        // Add any additional scripts if needed
    </script>
}