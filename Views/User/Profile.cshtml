@using System.Security.Claims
@model BachHoaXanh.ViewModels.UpdateProfileView

@{
    ViewData["Title"] = "Thông tin tài khoản";
    string rankIcon = "";
    string rankColor = "";
    string rankShadow = "";
    string rankClass = Model.Rank?.ToLower().Replace(" ", "-") ?? "chua-xep-hang";

    string fullName = Model.UserName ?? "Khách hàng";

    switch (Model.Rank)
    {
        case "Vàng":
            rankIcon = @"<svg width='40' height='40' viewBox='0 0 24 24' fill='none' style='filter: drop-shadow(0 0 8px #ffe082);'><defs><radialGradient id='goldGrad' cx='50%' cy='50%' r='50%'><stop offset='0%' stop-color='#fffde7'/><stop offset='100%' stop-color='#FFC107'/></radialGradient></defs><circle cx='12' cy='12' r='12' fill='url(#goldGrad)'/><path d='M12 6l2.09 4.26L19 10.27l-3.45 3.36L16.18 19 12 16.77 7.82 19l.63-5.37L5 10.27l4.91-.01L12 6z' fill='#fff'/></svg>";
            rankColor = "#FFC107";
            rankShadow = "0 0 12px #ffe082";
            break;
        case "Bạc":
            rankIcon = @"<svg width='40' height='40' viewBox='0 0 24 24' fill='none' style='filter: drop-shadow(0 0 8px #b0bec5);'><defs><radialGradient id='silverGrad' cx='50%' cy='50%' r='50%'><stop offset='0%' stop-color='#fff'/><stop offset='100%' stop-color='#90CAF9'/></radialGradient></defs><circle cx='12' cy='12' r='12' fill='url(#silverGrad)'/><path d='M12 6l2.09 4.26L19 10.27l-3.45 3.36L16.18 19 12 16.77 7.82 19l.63-5.37L5 10.27l4.91-.01L12 6z' fill='#fff'/></svg>";
            rankColor = "#90CAF9";
            rankShadow = "0 0 12px #b0bec5";
            break;
        case "Đồng":
            rankIcon = @"<svg width='40' height='40' viewBox='0 0 24 24' fill='none' style='filter: drop-shadow(0 0 8px #ffab91);'><defs><radialGradient id='bronzeGrad' cx='50%' cy='50%' r='50%'><stop offset='0%' stop-color='#fff3e0'/><stop offset='100%' stop-color='#FF7043'/></radialGradient></defs><circle cx='12' cy='12' r='12' fill='url(#bronzeGrad)'/><path d='M12 6l2.09 4.26L19 10.27l-3.45 3.36L16.18 19 12 16.77 7.82 19l.63-5.37L5 10.27l4.91-.01L12 6z' fill='#fff'/></svg>";
            rankColor = "#FF7043";
            rankShadow = "0 0 12px #ffab91";
            break;
        case "Kim cương":
            rankIcon = @"<svg width='40' height='40' viewBox='0 0 24 24' fill='none' style='filter: drop-shadow(0 0 20px #00e5ff);'><defs><radialGradient id='diamondBlackGrad' cx='50%' cy='50%' r='50%'><stop offset='0%' stop-color='#fff'/><stop offset='100%' stop-color='#222'/></radialGradient></defs><circle cx='12' cy='12' r='12' fill='url(#diamondBlackGrad)'/><g><polygon points='12,7 16,14 8,14' fill='#fff'/><polygon points='12,9.5 9.5,14 14.5,14' fill='#222'/></g><g><circle cx='12' cy='12' r='12' fill='url(#diamondBlackGrad)' opacity='0.18'/></g><g><animateTransform attributeName='transform' type='rotate' from='0 12 12' to='360 12 12' dur='2s' repeatCount='indefinite'/><polygon points='12,4 13,8 11,8' fill='#00e5ff' opacity='0.7'/></g></svg>";
            rankColor = "#222";
            rankShadow = "0 0 24px #00e5ff, 0 0 48px #b2ebf2";
            break;
        default:
            rankIcon = @"<svg width='40' height='40' viewBox='0 0 24 24' fill='none' style='filter: drop-shadow(0 0 6px #bdbdbd);'><circle cx='12' cy='12' r='12' fill='#E0E0E0'/><text x='12' y='16' text-anchor='middle' font-size='18' fill='#bdbdbd'>?</text></svg>";
            rankColor = "#E0E0E0";
            rankShadow = "0 0 8px #bdbdbd";
            break;
    }
}

<style>
    .profile-container {
        background: linear-gradient(135deg, #f9f9f9 0%, #ffffff 100%);
        border-radius: 10px;
        box-shadow: 0 6px 15px rgba(0, 0, 0, 0.1);
        padding: 25px;
        margin-top: 20px;
        max-width: 800px;
        margin-left: auto;
        margin-right: auto;
    }

        .profile-container h2 {
            font-size: 28px;
            color: #2e7d32;
            text-align: center;
            margin-bottom: 25px;
            font-weight: 700;
            border-bottom: 2px solid #4caf50;
            padding-bottom: 10px;
        }

        .profile-container h3 {
            font-size: 22px;
            color: #2e7d32;
            margin-top: 30px;
            margin-bottom: 15px;
            font-weight: 600;
        }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            font-weight: 500;
            color: #333;
            margin-bottom: 8px;
            display: block;
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            width: 100%;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 6px;
            font-size: 16px;
            transition: border-color 0.3s, box-shadow 0.3s;
        }

            .form-group input:focus,
            .form-group select:focus,
            .form-group textarea:focus {
                border-color: #4caf50;
                box-shadow: 0 0 6px rgba(76, 175, 80, 0.3);
                outline: none;
            }

    .auth-btn {
        background-color: #4caf50;
        color: white;
        padding: 12px 25px;
        border: none;
        border-radius: 6px;
        font-size: 16px;
        cursor: pointer;
        transition: background-color 0.3s, transform 0.2s;
    }

        .auth-btn:hover {
            background-color: #45a049;
            transform: scale(1.05);
        }

    .logout-btn {
        background-color: #757575;
        color: white;
        padding: 12px 25px;
        border: none;
        border-radius: 6px;
        font-size: 16px;
        cursor: pointer;
        transition: background-color 0.3s, transform 0.2s;
        text-decoration: none;
        display: inline-block;
    }

        .logout-btn:hover {
            background-color: #616161;
            transform: scale(1.05);
        }

    .address-section {
        margin-top: 10px;
    }

        .address-section select {
            background-color: #f9f9f9;
            cursor: pointer;
        }

            .address-section select option[value="add-new"] {
                font-style: italic;
                color: #4caf50;
            }

    .membership-section {
        background: linear-gradient(135deg, #e8f5e9 0%, #ffffff 100%);
        padding: 15px;
        border-radius: 6px;
        border: 1px solid #4caf50;
        margin-top: 20px;
        margin-bottom: 20px;
    }

    .membership-info {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

    .membership-badge {
        background-color: #ffd700;
        color: #333;
        padding: 8px 15px;
        border-radius: 50%;
        font-weight: 700;
        font-size: 16px;
        transition: transform 0.2s;
    }

        .membership-badge:hover {
            transform: scale(1.1);
        }

    .progress-container {
        margin-top: 15px;
    }

    .progress-bar {
        height: 10px;
        background: #e0e0e0;
        border-radius: 5px;
        overflow: hidden;
        position: relative;
    }

    .progress-fill {
        height: 100%;
        background: linear-gradient(90deg, #4caf50, #8bc34a);
        border-radius: 5px;
        transition: width 0.5s ease;
    }

    .rank-milestones {
        display: flex;
        justify-content: space-between;
        margin-top: 5px;
        font-size: 12px;
        color: #666;
    }

    .rank-milestone {
        text-align: center;
        position: relative;
    }

    .rank-milestone::before {
        content: '';
        position: absolute;
        top: -15px;
        left: 50%;
        transform: translateX(-50%);
        width: 2px;
        height: 10px;
        background: #ccc;
    }

    .current-rank {
        color: #4caf50;
        font-weight: bold;
        }

    @@media (max-width: 768px) {
        .profile-container

    {
        padding: 15px;
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
        font-size: 14px;
    }

    .auth-btn, .logout-btn {
        width: 100%;
        margin-top: 10px;
    }

    .membership-section {
        flex-direction: column;
        text-align: center;
    }

    }

    .membership-card-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin: 32px 0 24px 0;
    }
    .membership-card {
        width: 480px;
        height: 210px;
        border-radius: 28px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.18), 0 1.5px 8px #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        position: relative;
        background: linear-gradient(120deg, #fff, #f5f5f5 80%);
        margin-bottom: 36px;
        transition: box-shadow 0.3s;
        overflow: hidden;
    }
    .membership-card.vàng { background: linear-gradient(120deg, #fffde7, #ffe082 80%); }
    .membership-card.bạc { background: linear-gradient(120deg, #f5fafd, #b0bec5 80%); }
    .membership-card.đồng { background: linear-gradient(120deg, #fff3e0, #ffab91 80%); }
    .membership-card.kim-cương { background: linear-gradient(120deg, #232526 0%, #00e5ff 100%); }
    .membership-card.chưa-xếp-hạng { background: linear-gradient(120deg, #f5f5f5, #e0e0e0 80%); }
    .card-icon {
        width: 80px;
        height: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        box-shadow: 0 0 24px rgba(0,0,0,0.10);
        background: rgba(255,255,255,0.8);
        margin-right: 32px;
        margin-left: 32px;
        position: relative;
    }
    .membership-card.kim-cương .card-icon {
        animation: diamond-glow 2s infinite alternate;
        box-shadow: 0 0 32px #00e5ff, 0 0 64px #b2ebf2;
    }
    @@keyframes diamond-glow {
        0% { box-shadow: 0 0 32px #00e5ff, 0 0 64px #b2ebf2; }
        100% { box-shadow: 0 0 64px #00e5ff, 0 0 120px #b2ebf2; }
    }
    .card-info {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
    }
    .card-rank {
        font-size: 28px;
        font-weight: bold;
        margin-bottom: 6px;
        letter-spacing: 1px;
        text-shadow: 0 2px 8px #fff;
    }
    .membership-card.vàng .card-rank { color: #FFC107; }
    .membership-card.bạc .card-rank { color: #90CAF9; }
    .membership-card.đồng .card-rank { color: #FF7043; }
    .membership-card.kim-cương .card-rank { color: #00e5ff; }
    .membership-card.chưa-xếp-hạng .card-rank { color: #BDBDBD; }
    .card-name {
        font-size: 20px;
        color: #222;
        font-weight: 500;
        margin-bottom: 2px;
    }
    .card-points {
        font-size: 18px;
        color: #666;
        font-weight: 400;
    }
    .card-logo {
        position: absolute;
        bottom: 18px;
        right: 24px;
        opacity: 0.13;
        width: 100px;
    }
    .membership-milestones {
        display: flex;
        justify-content: center;
        gap: 36px;
        margin-bottom: 16px;
    }
    .milestone {
        display: flex;
        flex-direction: column;
        align-items: center;
        font-size: 14px;
        color: #888;
        font-weight: 500;
    }
    .milestone-icon {
        width: 32px;
        height: 32px;
        margin-bottom: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .milestone.active .milestone-icon {
        filter: drop-shadow(0 0 10px #ffc107);
        transform: scale(1.15);
    }
    .milestone.gold .milestone-icon { color: #FFC107; }
    .milestone.silver .milestone-icon { color: #90CAF9; }
    .milestone.bronze .milestone-icon { color: #FF7043; }
    .milestone.diamond .milestone-icon { color: #00e5ff; }
    .milestone.unranked .milestone-icon { color: #BDBDBD; }
    .progress-bar-modern {
        width: 480px;
        margin: 0 auto 18px auto;
    }
    .progress-bar-modern .bar-bg {
        height: 18px;
        background: #e0e0e0;
        border-radius: 9px;
        overflow: hidden;
        margin-bottom: 8px;
        box-shadow: 0 2px 8px #eee;
    }
    .progress-bar-modern .bar-fill {
        height: 100%;
        background: linear-gradient(90deg, #00e5ff 0%, #4caf50 100%);
        border-radius: 9px;
        transition: width 0.5s;
    }
    .progress-bar-modern .bar-label {
        text-align: right;
        font-size: 15px;
        color: #666;
        font-weight: 500;
    }
</style>

<div class="container-wrapper">
    @await Html.PartialAsync("_SidebarOverplay")
</div>
<div class="container-wrapper">
    @await Html.PartialAsync("UserSidebarPartial")
    <div class="content flex-1 pl-[280px]">
        <div class="profile-container">
            <div class="breadcrumb-icon d-inline-block">
                <a href="/Home/Index" class="fas fa-chevron-left"></a>
            </div>
            <h2>Thông tin tài khoản</h2>
            <form asp-action="UpdateProfile" method="post">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label for="username">Tên đăng nhập</label>
                    <input type="text" id="username" name="UserName" value="@Model.UserName" readonly />
                </div>
                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" id="email" asp-for="Email" name="email" placeholder="Nhập email" value="@Model.Email">
                </div>
                <div class="form-group">
                    <label for="phone">Số điện thoại</label>
                    <input type="tel" id="phone" asp-for="Phone" name="phone" placeholder="Nhập số điện thoại" value="@Model.Phone">
                </div>
                <div class="form-group address-section">
                    <label for="address">Quản lý địa chỉ</label>
                    <select id="address" onchange="handleAddressSelection(this)">
                        @if (Model.Addresses != null && Model.Addresses.Any())
                        {
                            foreach (var address in Model.Addresses)
                            {
                                var addressString = $"{address.Street}, {address.Ward}, {address.District}, {address.Province}";
                                if (address.IsDefault)
                                {
                                    <option value="@address.AddressID" selected>
                                        @addressString (Mặc định)
                                    </option>
                                }
                                else
                                {
                                    <option value="@address.AddressID">
                                        @addressString
                                    </option>
                                }
                            }
                        }
                        else
                        {
                            <option value="" disabled selected>Chưa có địa chỉ nào</option>
                        }
                        <option value="add-new">Thêm địa chỉ mới</option>
                    </select>
                </div>
                <div class="membership-card-container">
                    <div class="membership-card @rankClass">
                        <div class="card-icon">
                            @Html.Raw(rankIcon)
                        </div>
                        <div class="card-info">
                            <div class="card-rank">@Model.Rank</div>
                            <div class="card-name">@fullName</div>
                            <div class="card-points">@Model.Points.ToString("N0") điểm</div>
                        </div>
                        <div class="card-logo">
                            <img src="/images/logo.png" alt="Logo" style="width:100px;" />
                        </div>
                    </div>
                    <div class="membership-milestones">
                        <div class="milestone unranked @(Model.Rank == "Chưa xếp hạng" ? "active" : "")">
                            <div class="milestone-icon"><svg width="32" height="32" viewBox="0 0 24 24"><circle cx="12" cy="12" r="12" fill="#E0E0E0"/><text x="12" y="16" text-anchor="middle" font-size="16" fill="#bdbdbd">?</text></svg></div>
                            <span>Chưa xếp hạng</span>
                        </div>
                        <div class="milestone bronze @(Model.Rank == "Đồng" ? "active" : "")">
                            <div class="milestone-icon"><svg width="32" height="32" viewBox="0 0 24 24"><circle cx="12" cy="12" r="12" fill="#FF7043"/></svg></div>
                            <span>Đồng</span>
                        </div>
                        <div class="milestone silver @(Model.Rank == "Bạc" ? "active" : "")">
                            <div class="milestone-icon"><svg width="32" height="32" viewBox="0 0 24 24"><circle cx="12" cy="12" r="12" fill="#90CAF9"/></svg></div>
                            <span>Bạc</span>
                        </div>
                        <div class="milestone gold @(Model.Rank == "Vàng" ? "active" : "")">
                            <div class="milestone-icon"><svg width="32" height="32" viewBox="0 0 24 24"><circle cx="12" cy="12" r="12" fill="#FFC107"/></svg></div>
                            <span>Vàng</span>
                        </div>
                        <div class="milestone diamond @(Model.Rank == "Kim cương" ? "active" : "")">
                            <div class="milestone-icon"><svg width="32" height="32" viewBox="0 0 24 24"><defs><radialGradient id="diamondMilestone" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#fff"/><stop offset="100%" stop-color="#00B8D4"/></radialGradient></defs><circle cx="12" cy="12" r="12" fill="url(#diamondMilestone)"/></svg></div>
                            <span>Kim cương</span>
                        </div>
                    </div>
                    @{
                        double progress = 0;
                        double min = 0, max = 0;
                        string nextRank = "";
                        double nextRankPoint = 0;
                        if (Model.Rank == "Kim cương") { min = 10000; max = 10000; progress = 100; nextRank = ""; nextRankPoint = 0; }
                        else if (Model.Rank == "Vàng") { min = 1000; max = 10000; progress = ((double)Model.Points - min) / (max - min) * 100; nextRank = "Kim cương"; nextRankPoint = 10000; }
                        else if (Model.Rank == "Bạc") { min = 500; max = 1000; progress = ((double)Model.Points - min) / (max - min) * 100; nextRank = "Vàng"; nextRankPoint = 1000; }
                        else if (Model.Rank == "Đồng") { min = 100; max = 500; progress = ((double)Model.Points - min) / (max - min) * 100; nextRank = "Bạc"; nextRankPoint = 500; }
                        else { min = 0; max = 100; progress = ((double)Model.Points - min) / (max - min) * 100; nextRank = "Đồng"; nextRankPoint = 100; }
                        progress = Math.Min(100, Math.Max(0, progress));
                        double remain = nextRankPoint - (double)Model.Points;
                    }
                    <div class="progress-bar-modern">
                        <div class="bar-bg">
                            <div class="bar-fill" style="width: @progress%;"></div>
                        </div>
                        @if (!string.IsNullOrEmpty(nextRank) && remain > 0)
                        {
                            <div class="bar-label">Cần thêm <b>@remain.ToString("N0")</b> điểm để lên hạng <b>@nextRank</b></div>
                        }
                    </div>
                </div>
                <button type="submit" class="auth-btn">Lưu thay đổi</button>
                @{
                    var role = User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value;
                    if (role == "Admin")
                    {
                        <a href="@Url.Action("FaceAuth", "Auth",new{userId = Model.UserId})" class="logout-btn">Đăng nhập vào trang quản lý</a>
                    }
                }
                <a href="@Url.Action("Logout", "User")" class="logout-btn">Đăng xuất tài khoản</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const categoryButton = document.querySelector('.category-button');
        const overlay = document.getElementById('overlay');
        const containerWrapper = document.querySelector('.container-wrapper');
        const sidebar = document.querySelector('.sidebar');

        categoryButton.addEventListener('click', () => {
            overlay.classList.add('d-block');
            sidebar.classList.remove('d-none');
            containerWrapper.classList.add('blur');
        });

        overlay.addEventListener('click', () => {
            overlay.classList.remove('d-block');
            sidebar.classList.add('d-none');
            containerWrapper.classList.remove('blur');
        });

        overlay.addEventListener('mousemove', (event) => {
            if (!sidebar.contains(event.target)) {
                overlay.classList.remove('d-block');
                sidebar.classList.add('d-none');
                containerWrapper.classList.remove('blur');
            }
        });

        function toggleCategorySub(categoryMain) {
            var categorySubs = document.querySelectorAll('.category-sub');
            categorySubs.forEach(function (sub) {
                if (sub !== categoryMain.nextElementSibling) {
                    sub.style.display = "none";
                }
            });

            var categorySub = categoryMain.nextElementSibling;
            if (categorySub.style.display === "none" || categorySub.style.display === "") {
                categorySub.style.display = "block";
            } else {
                categorySub.style.display = "none";
            }
        }

        function handleAddressSelection(select) {
            if (select.value === "add-new") {
                window.location.href = '@Url.Action("AddAddress", "User")';
            }
        }
    </script>
}