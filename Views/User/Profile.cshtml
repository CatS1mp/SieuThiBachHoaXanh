@using System.Security.Claims
@model BachHoaXanh.Models.UpdateProfileView

@{
    ViewData["Title"] = "Thông tin tài khoản";
}

<div class="container-wrapper">
    @await Html.PartialAsync("_SidebarOverplay")
</div>
<div class="container-wrapper">

    @await Html.PartialAsync("UserSidebarPartial")
    <div class="content flex-1 pl-[280px]"> 
       

        <div class="profile-container">
            <div class="breadcrumb-icon d-inline-block">
                <a href="/Home/Index" class="fas fa-chevron-left"></a>
            </div>
            <h2>Thông tin tài khoản</h2>
            <form asp-action="UpdateProfile" method="post">
        
                @Html.AntiForgeryToken()    

                <div class="form-group">
                    <label for="username">Tên đăng nhập</label>
                    <input type="text" id="username" name="UserName" value="@Model.UserName" readonly />
                </div>
                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" id="email" asp-for="Email" name="email" placeholder="Nhập email" value="@Model.Email">
                </div>
                <div class="form-group">
                    <label for="phone">Số điện thoại</label>
                    <input type="tel" id="phone" asp-for="Phone" name="phone" placeholder="Nhập số điện thoại" value="@Model.Phone">
                </div>
<div class="container-small-wrapper">
    <div class="breadcrumb-container">
        <div class="breadcrumb-icon d-inline-block">
            <i class="fas fa-chevron-left"></i>
        </div>
        <p>Bạn có thể chỉnh sửa thông tin tài khoản ở đây</p>
    </div>

    <div class="profile-container">
        <h2>Thông tin tài khoản</h2>
        <form asp-action="UpdateProfile" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label for="username">Tên đăng nhập</label>
                <input type="text" id="username" name="UserName" value="@Model.UserName" readonly />
            </div>
            <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" asp-for="Email" name="email" placeholder="Nhập email" value="@Model.Email">
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="phone">Số điện thoại</label>
                <input type="tel" id="phone" asp-for="Phone" name="phone" placeholder="Nhập số điện thoại" value="@Model.Phone">
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>
            
            @{
                var role = User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value;
            <div class="form-group">
                <label for="address">Địa chỉ mặc định</label>
                <textarea id="address" asp-for="Address" placeholder="Địa chỉ giao hàng">@Model.Address</textarea>
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
            <button type="submit" class="auth-btn">Lưu thay đổi</button>
        

                Console.WriteLine(role);

                if (role == "Admin")
                {
                    <a href="@Url.Action("Index", "Admin")" type="submit" class="logout-btn">Đăng nhập vào trang quản lý</a>
                }
            }

            <a href="@Url.Action("Logout","User")" type="submit" class="logout-btn">Đăng xuất tài khoản</a>
         </form>

        </div>
    </div>
</div>
        <h3>Danh sách địa chỉ</h3>
        <a href="@Url.Action("AddAddress", "User")" class="auth-btn">Thêm địa chỉ mới</a>
        <div class="address-list">
            @if (Model.Addresses != null && Model.Addresses.Any())
            {
                foreach (var address in Model.Addresses)
                {
                    <div class="address-item">
                        <p>
                            <strong>@address.Street, @address.Ward, @address.District, @address.Province</strong>
                            @if (address.IsDefault)
                            {
                                <span> (Mặc định)</span>
                            }
                        </p>
                        <div class="address-actions">
                            <a href="@Url.Action("EditAddress", "User", new { id = address.AddressID })" class="btn btn-sm btn-primary">Sửa</a>
                            <form asp-action="DeleteAddress" asp-route-id="@address.AddressID" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Bạn có chắc muốn xóa địa chỉ này?');">Xóa</button>
                            </form>
                        </div>
                    </div>
                }
            }
            else
            {
                <p>Chưa có địa chỉ nào được thêm.</p>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const categoryButton = document.querySelector('.category-button');
        const overlay = document.getElementById('overlay');
        const containerWrapper = document.querySelector('.container-wrapper');
        const sidebar = document.querySelector('.sidebar');

        categoryButton.addEventListener('click', () => {
            overlay.classList.add('d-block');
            sidebar.classList.remove('d-none');
            containerWrapper.classList.add('blur');
        });

        overlay.addEventListener('click', () => {
            overlay.classList.remove('d-block');
            sidebar.classList.add('d-none');
            containerWrapper.classList.remove('blur');
        });

        overlay.addEventListener('mousemove', (event) => {
            if (!sidebar.contains(event.target)) {
                overlay.classList.remove('d-block');
                sidebar.classList.add('d-none');
                containerWrapper.classList.remove('blur');
            }
        });

        function toggleCategorySub(categoryMain) {
            var categorySubs = document.querySelectorAll('.category-sub');
            categorySubs.forEach(function (sub) {
                if (sub !== categoryMain.nextElementSibling) {
                    sub.style.display = "none";
                }
            });

            var categorySub = categoryMain.nextElementSibling;
            if (categorySub.style.display === "none" || categorySub.style.display === "") {
                categorySub.style.display = "block";
            } else {
                categorySub.style.display = "none";
            }
        }
    </script>
}