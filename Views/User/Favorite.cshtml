@using System.Security.Claims
@model BachHoaXanh.ViewModels.ProductViewModel


@{
    ViewData["Title"] = "Sản phẩm yêu thích";
}

<div class="container-wrapper">

    @await Html.PartialAsync("_SidebarOverplay")
</div>
<div class="container-wrapper">

    @await Html.PartialAsync("UserSidebarPartial")
    <div class="content flex-1 pl-[280px]">
       
        <div class="profile-container">
            <div class="breadcrumb-icon d-inline-block">
                <a href="/Home/Index" class="fas fa-chevron-left"></a>
            </div>
            <h2>Sản phẩm yêu thích</h2>
            <div id="product-list-container" class="product-list-container">
                @foreach (var product in Model.Products)
                {
                    <div class="product-item">
                        <img data-is-favorited="@product.isFav.ToString().ToLower()"
                             onclick="toggleFavorite(@product.ProductID, this)" class="icon-fav"
                             src="~/images/@(product.isFav ? "favor.png" : "unfavor.png")" />
                        @if (product.Images != null && product.Images.Any())
                        {
                            <img class="product-image" src="~/images/@product.Images.FirstOrDefault(img => img.IsMainImage)?.ImagePath" alt="@product.ProductName">
                        }
                        else
                        {
                            <img class="product-image" src="~/images/default-image.png" alt="@product.ProductName">
                        }
                        <h3 class="product-name">@product.ProductName</h3>
                        <div class="product-info">
                            <p class="product-price">Giá: <b>@product.Price.ToString("N0") VNĐ</b></p>
                        </div>
                        <div class="product-btn"><a href="@Url.Action("Detail", "Home", new { id = product.ProductID })" class="btn">Chi tiết</a></div>
                    </div>
                }
            </div>

            <!-- Pagination -->
            <div class="pagination-container">
                @if (Model.CurrentPage > 1)
                {
                    <a href="@Url.Action("Favorite", "User", new { page = Model.CurrentPage - 1, search = Model.SearchQuery, danhmuc = Model.SubCategoryId })" class="page-btn">
                        <i class="fas fa-chevron-left"></i> Quay lại
                    </a>
                }

                <span class="page-info">Trang @Model.CurrentPage/@Model.TotalPages</span>

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a href="@Url.Action("Favorite", "User", new { page = Model.CurrentPage - 1, search = Model.SearchQuery, danhmuc = Model.SubCategoryId })" class="page-btn">
                        Tiếp tục <i class="fas fa-chevron-right"></i>
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<script>

    const categoryButton = document.querySelector('.category-button');
    const overlay = document.getElementById('overlay');
    const containerWrapper = document.querySelector('.container-wrapper');
    const sidebar = document.querySelector('.sidebar'); // Thêm selector cho sidebar

    categoryButton.addEventListener('click', () => {
       overlay.classList.add('d-block');
       sidebar.classList.remove('d-none');
       containerWrapper.classList.add('blur');
    });

    overlay.addEventListener('click', () => {
       overlay.classList.remove('d-block');
       sidebar.classList.add('d-none');
       containerWrapper.classList.remove('blur');
    });

    overlay.addEventListener('mousemove', (event) => {
       if (!sidebar.contains(event.target)) {
          overlay.classList.remove('d-block');
          sidebar.classList.add('d-none');
          containerWrapper.classList.remove('blur');
       }
    });

    function toggleCategorySub(categoryMain) {
       var categorySubs = document.querySelectorAll('.category-sub');

       categorySubs.forEach(function (sub) {
          if (sub !== categoryMain.nextElementSibling) {
             sub.style.display = "none";
          }
       });

       var categorySub = categoryMain.nextElementSibling;

       if (categorySub.style.display === "none" || categorySub.style.display === "") {
          categorySub.style.display = "block";
       } else {
          categorySub.style.display = "none";
       }
    }

	function goBack(){
		window.history.back();
	}

    function getAntiForgeryToken() {
        return document.querySelector('meta[name="csrf-token"]').getAttribute('content');
    }
        async function toggleFavorite(productId, el) {
        let isFavorited = el.dataset.isFavorited === "true";

        const url = isFavorited
            ? '/Home/RemoveFromFavorites'
            : '/Home/AddToFavorites';

        const formData = new FormData();
        formData.append("productId", productId);

        // Append the current path as returnUrl
        formData.append("returnUrl", window.location.pathname + window.location.search);

        const response = await fetch(url, {
            method: "POST",
            body: formData,
            headers: {
                'RequestVerificationToken': getAntiForgeryToken()
            }
        });

        if (response.ok) {
            location.reload(); // or redirect manually if needed
        } else {
            alert("Có lỗi xảy ra khi gửi yêu cầu.");
        }
    }

</script>