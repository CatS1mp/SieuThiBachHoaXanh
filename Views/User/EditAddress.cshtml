@model BachHoaXanh.Models.AddressViewModel

@{
    ViewData["Title"] = "Sửa địa chỉ";
}

<div class="container-small-wrapper">
    <div class="breadcrumb-container">
        <div class="breadcrumb-icon d-inline-block">
            <i class="fas fa-chevron-left"></i>
        </div>
        <p>Sửa địa chỉ</p>
    </div>

    <div class="profile-container">
        <h2>Sửa địa chỉ</h2>
        <form asp-action="EditAddress" asp-route-id="@Model.AddressID" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label for="Province">Tỉnh/Thành phố</label>
                <input type="text" id="Province" asp-for="Province" class="form-control" placeholder="Nhập tỉnh/thành phố" />
                <span asp-validation-for="Province" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="District">Quận/Huyện</label>
                <input type="text" id="District" asp-for="District" class="form-control" placeholder="Nhập quận/huyện" />
                <span asp-validation-for="District" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="Ward">Phường/Xã</label>
                <input type="text" id="Ward" asp-for="Ward" class="form-control" placeholder="Nhập phường/xã" />
                <span asp-validation-for="Ward" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="Street">Đường/Số nhà</label>
                <input type="text" id="Street" asp-for="Street" class="form-control" placeholder="Nhập đường/số nhà" />
                <span asp-validation-for="Street" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="IsDefault">Đặt làm địa chỉ mặc định</label>
                <input type="checkbox" asp-for="IsDefault" />
            </div>
            <button type="submit" class="auth-btn">Lưu thay đổi</button>
        </form>
        <a href="@Url.Action("Profile", "User")" class="logout-btn">Quay lại</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}