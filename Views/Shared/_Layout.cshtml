@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json
@inject IHttpContextAccessor HttpContextAccessor
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Xsrf

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BachHoaXanh</title>
    <meta name="csrf-token" content="@Xsrf.GetAndStoreTokens(Context).RequestToken" />

    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-select@1.13.14/dist/css/bootstrap-select.min.css">
    <link rel="stylesheet" href="~/BachHoaXanh.styles.css" asp-append-version="true" />

    <style>
        body {
            font-family: 'Roboto', sans-serif;
        }
    </style>
</head>
<body>

    
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top align-items-left" style="padding-bottom: 0!important">
        <div class="container"
             style="max-width: 1200px!important; padding-left: 0!important; padding-right: 0!important">
            <div class="navbar-brand-container">
                <a href="@Url.Action("Index", "Home")" class="navbar-brand" style="padding-top: 0!important; padding-bottom: 0!important">
                    <img src="~/images/logo.png" alt="Logo" class="logo">
                </a>
                <button class="category-button">
                    <i class="fa-solid fa-bars pr-2 pl-2"></i>
                    DANH MỤC SẢN PHẨM
                </button>
            </div>
            <div class="collapse navbar-collapse d-flex justify-content-between" id="navbarNav">
                <div class="search-bar mx-auto">
                    <form method="get" action="@Url.Action("Index", "Home")" class="search-bar mx-auto">
                        <div class="input-group">
                            <i class="fa fa-search search-icon"></i>
                            <input type="search" class="form-control rounded" id="searchQuery" name="search" value="@ViewData["Search"]" placeholder="Tìm sản phẩm...">
                        </div>
                    </form>



                </div>
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="information-btn nav-link mr-2" href="@Url.Action("Profile", "User")">
                            <i class="fa-solid fa-user mr-2"></i>Tài khoản
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="information-btn nav-link mr-2" href="@Url.Action("Index", "Order")">
                            <i class="fa-solid fa-bag-shopping mr-2"></i>Đơn hàng
                        </a>
                    </li>
                    <li class="nav-item cart-container">
                        <a class="cart-btn nav-link" href="@Url.Action("Index", "Cart")"><i class="fa-solid fa-cart-shopping"></i></a>
                        @await Html.PartialAsync("_CartCountPartial")
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    @RenderBody()


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-select@1.13.14/dist/js/bootstrap-select.min.js"></script>

    <script>

        var swiper2 = new Swiper(".mySwiper2", {
           loop: true,
           cssMode: true,
           spaceBetween: 10,
           slidesPerView: 5,
           mousewheel: true,
           freeMode: true,
           watchSlidesProgress: true,
        });
        var swiper1 = new Swiper(".mySwiper", {
           slidesPerView: 1,
           cssMode: true,
           spaceBetween: 30,
           mousewheel: true,
           loop: true,
           pagination: {
              el: ".swiper-pagination",
              type: "fraction"
           },
           navigation: {
              nextEl: ".swiper-btn-next",
              prevEl: ".swiper-btn-prev",
           },
           thumbs: {
              swiper: swiper2,
           },
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
