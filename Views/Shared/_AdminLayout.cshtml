<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="~/admin/img/favicon.ico">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />

    <title>@ViewData["Title"] - Quản Lý</title>

    <meta content='width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0' name='viewport' />
    <meta name="viewport" content="width=device-width" />


    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <link href="~/admin/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/admin/css/animate.min.css" rel="stylesheet" />
    <link href="~/admin/css/light-bootstrap-dashboard.css?v=1.4.0" rel="stylesheet" />
    <link href="~/admin/css/demo.css" rel="stylesheet" />
    <link href="http://maxcdn.bootstrapcdn.com/font-awesome/4.2.0/css/font-awesome.min.css" rel="stylesheet">
    <link href='http://fonts.googleapis.com/css?family=Roboto:400,700,300' rel='stylesheet' type='text/css'>
    <link href="~/admin/css/pe-icon-7-stroke.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <style>
        .card {
        border: 1px solid #ddd;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        padding: 20px;
        margin-bottom: 20px;
        }
        .card .header {
            background-color: #4CAF50;
            padding: 20px !important;
            border-radius: 5px;
        }
        .card .title{
            color: #fff;
            font-weight: bold;
        }
        .card h3 {
            color: #4CAF50;
            font-weight: bold;
        }
        .card p {
            color: #777;
        }

        .table-container {
            padding: 20px;
            width: 90%;
            margin: 20px auto;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            background: white;
            border-radius: 8px;
            overflow: hidden;
            margin-bottom: 200px;
        }

        /* Bảng chung */
        .table {
            width: 100%;
            border-collapse: collapse;
            border: 1px solid #c3c3c3;
        }

            .table th {
                color: #fff;
                font-weight: bold;
                background-color: #51835f;
            }

            .table th,
            .table td {
                padding: 10px;
                text-align: left;
                vertical-align: middle;
                border: none;
            }

            .table .product-name {
                font-weight: bold;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                max-width: 300px;
            }

            /* Tùy chỉnh cột sản phẩm */
            .table td:first-child {
                display: flex;
                align-items: center;
            }

            .table .product-img {
                width: 80px;
                height: 80px;
                object-fit: cover;
                margin-right: 10px;
                border-radius: 5px;
                border: 1px solid #ccc;
            }

            .table .info {
                display: flex;
                flex-direction: column;
            }

            .table .product-category {
                color: #666;
                font-size: 0.9em;
            }
            .table .sorting{
                color: #fff;
            }
        /* Trạng thái sản phẩm */
        .text-success {
            color: green;
        }

        .text-danger {
            color: red;
        }

        .text-warning {
            color: orange;
        }

        .table .btn {
            margin: 0;
        }

        .table .btn {
            transition: all 0.2s ease-in-out;
        }

        .table .btn-success:hover {
            background-color: #28a745;
            color: #fff;
            transform: scale(1.05);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        }

        .table .btn-danger:hover {
            background-color: #dc3545;
            color: #fff;
            transform: scale(1.05);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        }
    </style>
</head>
<body>

    <div class="wrapper">
        <div class="sidebar" data-color="green" data-image="~/admin/img/sidebar-5.jpg">
            <div class="sidebar-wrapper">
                <div class="logo">
                    <a href="http://www.creative-tim.com" class="simple-text">
                        Bách Hoá Xanh
                    </a>
                </div>

                <ul class="nav">
                    <li class="">
                        <a href="@Url.Action("Index","Admin")">
                            <i class="pe-7s-graph"></i>
                            <p>Thống kê</p>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Users","Admin")">
                            <i class="pe-7s-user"></i>
                            <p>Quản lý người dùng</p>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Products","Admin")">
                            <i class="pe-7s-note2"></i>
                            <p>Quản lý sản phẩm</p>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Orders","Admin")">
                            <i class="pe-7s-news-paper"></i>
                            <p>Quản lý hoá đơn</p>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Categories","Admin")">
                            <i class="pe-7s-science"></i>
                            <p>Quản lý danh mục</p>
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        @*Content*@

        @RenderBody()

    
        <footer class="footer">
            <div class="container-fluid">
                <nav class="pull-left">
                    <ul>
                    </ul>
                </nav>
                <p class="copyright pull-right">
                    &copy; <script>document.write(new Date().getFullYear())</script> <a href="http://www.creative-tim.com">BachHoaXanh</a>, Made by Tuan & Minh
                </p>
            </div>
        </footer>

    </div>


</body>

    <script src="~/admin/js/bootstrap.min.js" type="text/javascript"></script>
    <script src="~/admin/js/chartist.min.js"></script>
    <script src="~/admin/js/bootstrap-notify.js"></script>
    <script src="https://maps.googleapis.com/maps/api/js?key=YOUR_KEY_HERE"></script>
    <script src="~/admin/js/light-bootstrap-dashboard.js?v=1.4.0"></script>
    <script src="~/admin/js/demo.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</html>
