<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="~/admin/img/favicon.ico">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <title>@ViewData["Title"] - Quản Lý</title>
    <meta content='width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0' name='viewport' />
    <meta name="viewport" content="width=device-width" />

    <!-- Consolidated CSS -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <link href="~/admin/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/admin/css/animate.min.css" rel="stylesheet" />
    <link href="~/admin/css/light-bootstrap-dashboard.css?v=1.4.0" rel="stylesheet" />
    <link href="~/admin/css/demo.css" rel="stylesheet" />
    <link href="~/admin/css/pe-icon-7-stroke.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">

    <style>
        html, body {
            height: 100%;
            margin: 0;
        }

        .wrapper {
            display: grid;
            grid-template-rows: auto 1fr auto; /* Header (navbar), main content, footer */
            min-height: 100vh;
        }

        .main-panel {
            flex: 1 0 auto; /* Grow to push footer down */
            padding-top: 70px; /* Adjust for fixed navbar */
            padding-bottom: 20px; /* Space before footer */
        }

        .navbar-fixed {
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 1000;
        }

        .footer {
            flex-shrink: 0; /* Prevent footer from shrinking */
            background-color: #f8f9fa;
            padding: 20px;
            text-align: center;
            border-top: 1px solid #e7e7e7;
        }

        .sidebar {
            z-index: 999; /* Ensure sidebar is below navbar */
        }
        /* Override light-bootstrap-dashboard defaults if needed */
        .main-panel {
            width: calc(100% - 260px); /* Adjust for sidebar width */
            margin-left: 260px; /* Match sidebar width */
        }
        @@media (max-width: 991px) {
        .main-pane
        {
            width: 100%;
            margin-left: 0;
        }

        .sidebar {
            display: none; /* Adjust based on your responsive design */
        }

        }
        /* Card and table styles from original, moved to view-specific if needed */
        .card {
            border: 1px solid #ddd;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            padding: 20px;
            margin-bottom: 20px;
        }

            .card .header {
                background-color: #4CAF50;
                padding: 20px !important;
                border-radius: 5px;
            }

            .card .title {
                color: #fff;
                font-weight: bold;
            }

            .card h3 {
                color: #4CAF50;
                font-weight: bold;
            }

            .card p {
                color: #777;
            }
    </style>
</head>
<body>
    <div class="wrapper">
        <div class="sidebar" data-color="green" data-image="@Url.Content("~/admin/img/sidebar-5.jpg")">
            <div class="sidebar-wrapper">
                <div class="logo">
                    <a href="http://www.creative-tim.com" class="simple-text">
                        Bách Hoá Xanh
                    </a>
                </div>
                <ul class="nav">
                    <li>
                        <a href="@Url.Action("Index","Admin")">
                            <i class="pe-7s-graph"></i>
                            <p>Thống kê</p>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Users","Admin")">
                            <i class="pe-7s-user"></i>
                            <p>Quản lý người dùng</p>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Products","Admin")">
                            <i class="pe-7s-note2"></i>
                            <p>Quản lý sản phẩm</p>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Orders","Admin")">
                            <i class="pe-7s-news-paper"></i>
                            <p>Quản lý hoá đơn</p>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Categories","Admin")">
                            <i class="pe-7s-science"></i>
                            <p>Quản lý danh mục</p>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Auth","Admin")">
                            <i class="fa fa-user-secret" aria-hidden="true"></i>
                            <p>Quản lý xác thực</p>
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        @RenderBody()

        <footer class="footer">
            <div class="container-fluid">
                <nav class="pull-left">
                    <ul>
                    </ul>
                </nav>
                <p class="copyright pull-right">
                    © <script>document.write(new Date().getFullYear())</script> <a href="http://www.creative-tim.com">BachHoaXanh</a>, Made by Tuan, Khoa & Lam
                </p>
            </div>
        </footer>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/admin/js/bootstrap.min.js"></script>
    <script src="~/admin/js/chartist.min.js"></script>
    <script src="~/admin/js/bootstrap-notify.js"></script>
    <script src="~/admin/js/light-bootstrap-dashboard.js?v=1.4.0"></script>
    <script src="~/admin/js/demo.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>