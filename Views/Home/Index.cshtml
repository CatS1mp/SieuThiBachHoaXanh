    <div class="row g-0 justify-content-center mx-5 mt-5">
        <div class="col-md-3 px-1">
            @await Html.PartialAsync("_Sidebar")
        </div>
        <div class="col-md-9 px-1">
            <!-- Product List -->
            <div id="product-list-container" class="product-list-container">
                @foreach (var product in Model.Products)
                {
                    <div class="col px-1 py-1">
                        <div class="card h-100 shadow-sm mb-2">
                            <img data-is-favorited="@product.isFav.ToString().ToLower()"
                                onclick="toggleFavorite(@product.ProductID, this)" class="icon-fav"
                                src="~/images/@(product.isFav ? "favor.png" : "unfavor.png")" />

                            @if (product.Images != null && product.Images.Any())
                            {
                                <img class="card-img-top"
                                    src="~/images/prods/@product.Images.FirstOrDefault(img => img.IsMainImage)?.ImagePath"
                                    alt="@product.ProductName" style="height: 200px; object-fit: cover;">
                            }
                            else
                            {
                                <img class="card-img-top" src="~/images/default-image.png" style="height: 200px; object-fit: cover;" alt="@product.ProductName">
                            }
                            <div class="card-body d-flex flex-column">
                                <h3 class="card-title">@product.ProductName</h3>
                                <p class="card-text">@product.Description</p>
                                <div class="d-flex flex-column align-items-start mb-auto">
                                    @if (product.StockQuantity == 0)
                                    {
                                        <span class="badge badge-sm bg-danger my-2">Tạm hết hàng</span>
                                    }
                                    <span class="h5 ">
                                        @if (product.PromotionPrice > 0)
                                        {
                                            <div class="text-muted " style="text-decoration: line-through;">
                                                @product.Price.ToString("N0") VNĐ
                                            </div>

                                            <div class="text-danger fw-bold fs-5">
                                                @product.PromotionPrice.ToString("N0") VNĐ
                                            </div>
                                        }
                                        else
                                        {

                                            <span class="fw-bold">@product.Price.ToString("N0") VNĐ</span>
                                        }
                                    </span>
                                </div>

                                <a href="/san-pham/@product.ProductID" class="btn btn-outline-primary product-btn">
                                    <i class="bi bi-cart-plus"></i> Xem chi tiết
                                </a>

                                </div>
                            </div>
                        </div>

                }
                @* <div class="product-info">
                    <p class="product-price">Giá: <b>@product.Price.ToString("N0") VNĐ</b></p>
                </div>
                <div class="product-btn"><a href="@Url.Action("Detail", "Home", new { id = product.ProductID })"
                        class="btn">Chi tiết</a></div> *@
            </div>
            <div id="product-list-container" class="product-list-container">

            </div>

            <!-- Pagination -->
            <div class="pagination-container">
                @if (Model.CurrentPage > 1)
                {
                    <a href="@Url.Action("Index", "Home", new { page = Model.CurrentPage - 1, search = Model.SearchQuery, danhmuc = Model.SubCategoryId })"
                        class="page-btn">
                        <i class="fas fa-chevron-left"></i> Quay lại
                    </a>
                }

                <span class="page-info">Trang @Model.CurrentPage/@Model.TotalPages</span>

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a href="@Url.Action("Index", "Home", new { page = Model.CurrentPage + 1, search = Model.SearchQuery, danhmuc = Model.SubCategoryId })"
                        class="page-btn">
                        Tiếp tục <i class="fas fa-chevron-right"></i>
                    </a>
                }
            </div>

        </div>

