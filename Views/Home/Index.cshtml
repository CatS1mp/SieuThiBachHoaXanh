    <div class="row justify-content-center mx-5">
        <div class="col">
            <div id="c-secondary-promotion" class="carousel slide " data-ride="carousel">
                <ol class="carousel-indicators">
                    @{
                        int slideIndex2 = 0;

                        for (int i = 0; i < Model.Promotions.Count; i++)
                        {
                            var promo = Model.Promotions[i];
                            if (!promo.ShowOnTop)
                            {
