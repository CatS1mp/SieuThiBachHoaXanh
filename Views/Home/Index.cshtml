@model BachHoaXanh.ViewModels.ProductViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, ViewComponentInMVC
@addTagHelper *, ViewComponentInMVC.TagHelpers

@{
    ViewData["Title"] = "Trang chủ";
}

@* https://img-s-msn-com.akamaized.net/tenant/amp/entityid/AA1sCDuN.img?w=720&h=590&m=4&q=100 *@
<div style="height: 70vh; width: 100%">
    <img src="https://cdn.britannica.com/17/196817-159-9E487F15/vegetables.jpg" alt="Absolute Cinema" style="height: 100vh; width: 100%; object-fit: cover;position: absolute; top:0; left: 0; filter: brightness(0.6); 
        -webkit-mask-image: linear-gradient(rgb(0 0 0 / 1),rgb(0 0 0 / 0.5) 90%,rgb(0 0 0 / 0));
        mask-image: linear-gradient(rgb(0 0 0 / 1),rgb(0 0 0 / 0.5) 90%,rgb(0 0 0 / 0))">
</div>
<div style="display: flex; justify-content: center; align-content: center;">

    <div class="container-wrapper " style="width: 90vw;">
        <div id="c-promotion" class="carousel slide " data-ride="carousel" style="padding: 10px;">
            <ol class="carousel-indicators">
                <li data-target="#c-promotion" data-slide-to="0" class="active"></li>
                <li data-target="#c-promotion" data-slide-to="1"></li>
                <li data-target="#c-promotion" data-slide-to="2"></li>
            </ol>
            <div class="carousel-inner rounded-lg   ">

                <div class="carousel-item active">
                    <img src="https://cdnv2.tgdd.vn/bhx-static/bhx/7910/freecompress-1440x800-1_202505260955424073.png"
                        class="d-block w-100" alt="...">
                </div>
                <div class="carousel-item">
                    <img src="https://cdnv2.tgdd.vn/bhx-static/bhx/7910/freecompress-1440x800-1_202505260955424073.png"
                        class="d-block w-100" alt="...">
                </div>
                <div class="carousel-item">
                    <img src="https://cdnv2.tgdd.vn/bhx-static/bhx/7910/freecompress-pc-1800x480-2_202505071644493334.jpg"
                        class="d-block w-100" alt="...">
                </div>
            </div>

            <button class="carousel-control-prev" type="button" data-target="#c-promotion" data-slide="prev">
                <span class="carousel-control-prev-icon"></span>
                <span class="sr-only">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-target="#c-promotion" data-slide="next">
                <span class="carousel-control-next-icon"></span>
                <span class="sr-only">Next</span>
            </button>
        </div>

        <div style="position: relative;">
            @await Html.PartialAsync("_Sidebar")
        </div>
        <div class="flex-1" style="padding-left: 310px; margin-left: 10px;">
            <!-- Product List -->
            <div id="product-list-container" class="product-list-container">
                @foreach (var product in Model.Products)
                {
                    <div class="product-item">
                        <img data-is-favorited="@product.isFav.ToString().ToLower()"
                            onclick="toggleFavorite(@product.ProductID, this)" class="icon-fav"
                            src="~/images/@(product.isFav ? "favor.png" : "unfavor.png")" />
                        @if (product.Images != null && product.Images.Any())
                        {
                            <img class="product-image"
                                src="~/images/@product.Images.FirstOrDefault(img => img.IsMainImage)?.ImagePath"
                                alt="@product.ProductName">
                        }
                        else
                        {
                            <img class="product-image" src="~/images/default-image.png" alt="@product.ProductName">
                        }
                        <h3 class="product-name">@product.ProductName</h3>
                        <div class="product-info">
                            <p class="product-price">Giá: <b>@product.Price.ToString("N0") VNĐ</b></p>

                            @if (product.PromotionPrice != -1)
                            {
                                <p class="product-discount" style="color:red;">Giá khuyến
                                    mãi:<b>@product.PromotionPrice.ToString("N0") VNĐ</b></p>
                            }
                        </div>
                        <div class="product-btn"><a href="@Url.Action("Detail", "Home", new { id = product.ProductID })"
                                class="btn">Chi tiết</a></div>
                    </div>
                }
            </div>

            <!-- Pagination -->
            <div class="pagination-container">
                @if (Model.CurrentPage > 1)
                {
                    <a href="@Url.Action("Index", "Home", new { page = Model.CurrentPage - 1, search = Model.SearchQuery, danhmuc = Model.SubCategoryId })"
                        class="page-btn">
                        <i class="fas fa-chevron-left"></i> Quay lại
                    </a>
                }

                <span class="page-info">Trang @Model.CurrentPage/@Model.TotalPages</span>

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a href="@Url.Action("Index", "Home", new { page = Model.CurrentPage + 1, search = Model.SearchQuery, danhmuc = Model.SubCategoryId })"
                        class="page-btn">
                        Tiếp tục <i class="fas fa-chevron-right"></i>
                    </a>
                }
            </div>

        </div>
    </div>
</div>

<script>
    function toggleCategorySub(categoryMain) {
        var categorySub = categoryMain.nextElementSibling;
        categorySub.style.display = (categorySub.style.display === "none" || categorySub.style.display === "") ? "block" : "none";
    }
    function getAntiForgeryToken() {
        return document.querySelector('meta[name="csrf-token"]').getAttribute('content');
    }
    async function toggleFavorite(productId, el) {
        let isFavorited = el.dataset.isFavorited === "true";

        const url = isFavorited
            ? '/Home/RemoveFromFavorites'
            : '/Home/AddToFavorites';

        const formData = new FormData();
        formData.append("productId", productId);

        // Append the current path as returnUrl
        formData.append("returnUrl", window.location.pathname + window.location.search);

        const response = await fetch(url, {
            method: "POST",
            body: formData,
            headers: {
                'RequestVerificationToken': getAntiForgeryToken()
            }
        });

        if (response.ok) {
            location.reload(); // or redirect manually if needed
        } else {
            alert("Có lỗi xảy ra khi gửi yêu cầu.");
        }
    }

</script>
