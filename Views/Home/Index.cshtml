@model BachHoaXanh.ViewModels.ProductViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, ViewComponentInMVC
@addTagHelper *, ViewComponentInMVC.TagHelpers

@{
    ViewData["Title"] = "Trang chủ";
}

@* https://img-s-msn-com.akamaized.net/tenant/amp/entityid/AA1sCDuN.img?w=720&h=590&m=4&q=100 *@

<div class="container-fluid px-0" style="position: relative; top: -37px;">
    <div class="row gy-0 mx-0">
        <div class="col-12 px-0">
            <div id="c-main-promotion " class="carousel slide" data-ride="carousel">
                <ol class="carousel-indicators">
                    @{
                        int slideIndex = 0;

                        for (int i = 0; i < Model.ActivePromotions.Count; i++)
                        {
                            var promo = Model.ActivePromotions[i];
                            if (!promo.ShowOnTop)
                            {
                                continue;
                            }

                            <li data-target="#c-main-promotion" data-slide-to="@slideIndex"
                                class="@(slideIndex == 0 ? "active" : "")">
                            </li>
                            slideIndex++;
                        }
                    }
                </ol>

                <div class="carousel-inner ">
                    @{
                        slideIndex = 0;
                        for (int i = 0; i < Model.ActivePromotions.Count; i++)
                        {
                            var promo = Model.ActivePromotions[i];
                            if (!promo.ShowOnTop)
                            {
                                continue;
                            }
                            Console.WriteLine(promo.ImagePath);
                            <div class="carousel-item @(slideIndex == 0 ? "active" : "")">
                                <img src="~/images/@promo.ImagePath" class="d-block w-100" alt="@promo.PromotionName"
                                    style="height: 50vh; object-fit: fill;-webkit-mask-image:linear-gradient(rgb(0 0 0 / 1),rgb(0 0 0 / 0.8) 80%,rgb(0 0 0 / 0));">
                            </div>
                            slideIndex++;
                        }
                    }
                </div>

                <button class=" carousel-control-prev" type="button" data-target="#c-main-promotion" data-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                    <span class="sr-only">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-target="#c-main-promotion" data-slide="next">
                    <span class="carousel-control-next-icon"></span>
                    <span class="sr-only">Next</span>
                </button>
            </div>
        </div>
    </div>

    <div class="row justify-content-center mx-5">
        <div class="col-12">
            <div id="c-secondary-promotion" class="carousel slide " data-ride="carousel">
                <ol class="carousel-indicators">
                    @{
                        int slideIndex2 = 0;

                        for (int i = 0; i < Model.ActivePromotions.Count; i++)
                        {
                            var promo = Model.ActivePromotions[i];
                            if (promo.ShowOnTop)
                            {
                                continue;
                            }

                            <li data-target="#c-main-promotion" data-slide-to="@slideIndex2"
                                class="@(slideIndex2 == 0 ? "active" : "")"></li>
                            slideIndex2++;
                        }
                    }
                </ol>

                <div class="carousel-inner rounded-lg   ">
                    @{
                        slideIndex2 = 0;
                        for (int i = 0; i < Model.ActivePromotions.Count; i++)
                        {
                            var promo = Model.ActivePromotions[i];
                            if (promo.ShowOnTop)
                            {
                                continue;
                            }
                            Console.WriteLine(promo.ImagePath);
                            <div class="carousel-item @(slideIndex2 == 0 ? "active" : "")">
                                <img src="~/images/@promo.ImagePath" class="d-block w-100" alt="@promo.PromotionName"
                                    style="height: 30vh; width: 80vw; object-fit: fill;">
                            </div>
                            slideIndex2++;
                        }
                    }
                </div>

                <button class="carousel-control-prev" type="button" data-target="#c-secondary-promotion"
                    data-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                    <span class="sr-only">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-target="#c-secondary-promotion"
                    data-slide="next">
                    <span class="carousel-control-next-icon"></span>
                    <span class="sr-only">Next</span>
                </button>
            </div>
        </div>
    </div>

    <div class="row justify-content-center mx-5 g-0">
        <div class="col col-md-2">
            @await Html.PartialAsync("_Sidebar")
        </div>
        <div class="col col-md-10">
            <div>
                @foreach (var category in Model.Categories)
                {
                    // Fetch subcategories for this category
                    var subCategoryIds = category.SubCategories?.Select(sc => sc.SubCategoryID).ToList() ?? new List<int>();
                    var categoryProducts = Model.Products
                    .Where(p => p.SubCategoryID.HasValue && subCategoryIds.Contains(p.SubCategoryID.Value))
                    .ToList();

                    if (categoryProducts.Any())
                    {
                        // Pagination logic for this category
                        int pageSize = 8;
                        int page = int.TryParse(Context.Request.Query[$"page_{category.CategoryID}"], out int categoryPage) ?
                        categoryPage : 1;
                        if (page < 1) page = 1;

                        int totalCategoryProducts = categoryProducts.Count;
                        int totalCategoryPages = (int)Math.Ceiling((double)totalCategoryProducts / pageSize);

                        if (page > totalCategoryPages && totalCategoryPages > 0)
                        {
                            page = totalCategoryPages;
                        }

                        var paginatedProducts = categoryProducts
                        .Skip((page - 1) * pageSize)
                        .Take(pageSize)
                        .ToList();

                        @await Html.PartialAsync("_CategoryProductList", new BachHoaXanh.ViewModels.ProductViewModel
                        {
                            Categories = new List<BachHoaXanh.Models.Category> { category },
                                Products = paginatedProducts,
                                FavoriteProducts = Model.FavoriteProducts,
                                ActivePromotions = Model.ActivePromotions,
                                CurrentPage = page,
                                TotalPages = totalCategoryPages,
                                TotalProducts = totalCategoryProducts,
                                SearchQuery = Model.SearchQuery,
                                SubCategoryId = Model.SubCategoryId
                                })
                                }
                }
            </div>
        </div>
    </div>
</div>

<div style="display: flex; justify-content: center; align-content: center;">

    <div class="container-wrapper " style="width: 85vw;">


        <style>
            body {
                padding-bottom: 50px;
            }
        </style>
    </div>

    <script>
        function toggleCategorySub(categoryMain) {
            var categorySub = categoryMain.nextElementSibling;
            categorySub.style.display = (categorySub.style.display === "none" || categorySub.style.display === "") ? "block" : "none";
        }
        function getAntiForgeryToken() {
            return document.querySelector('meta[name="csrf-token"]').getAttribute('content');
        }
        async function toggleFavorite(productId, el) {
            let isFavorited = el.dataset.isFavorited === "true";

            const url = isFavorited
                ? '/Home/RemoveFromFavorites'
                : '/Home/AddToFavorites';

            const formData = new FormData();
            formData.append("productId", productId);

            // Append the current path as returnUrl
            formData.append("returnUrl", window.location.pathname + window.location.search);

            const response = await fetch(url, {
                method: "POST",
                body: formData,
                headers: {
                    'RequestVerificationToken': getAntiForgeryToken()
                }
            });

            if (response.ok) {
                location.reload(); // or redirect manually if needed
            } else {
                alert("Có lỗi xảy ra khi gửi yêu cầu.");
            }
        }

    </script>
