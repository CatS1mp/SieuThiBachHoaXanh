                            }

                            <li data-target="#c-secondary-promotion" data-slide-to="@slideIndex2"
                                class="@(slideIndex2 == 0 ? "active" : "")"></li>
                            slideIndex2++;
                        }
                    }
                </ol>

                <div class="carousel-inner rounded-lg   ">
                    @{
                        slideIndex2 = 0;
                        for (int i = 0; i < Model.Promotions.Count; i++)
                        {
                            var promo = Model.Promotions[i];
                            if (!promo.ShowOnTop)
                            {
                                continue;
                            }
                            Console.WriteLine(promo.ImagePath);
                            <div class="carousel-item @(slideIndex2 == 0 ? "active" : "")">
                                <img src="~/images/@promo.ImagePath" class="d-block w-100" alt="@promo.PromotionName"
                                    style="height: 30vh; width: 80vw; object-fit: fill;">
                            </div>
                            slideIndex2++;
                        }
                    }
                </div>

                <button class="carousel-control-prev" type="button" data-target="#c-secondary-promotion"
                    data-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                    <span class="sr-only">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-target="#c-secondary-promotion"
