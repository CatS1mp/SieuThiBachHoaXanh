@model BachHoaXanh.ViewModels.ProductViewModel

<div class="category-product-grid">
    <h2 class="category-title">@Model.Categories.FirstOrDefault()?.CategoryName</h2>
    <!-- Product Grid -->
    <div id="product-list-container-@Model.Categories.FirstOrDefault()?.CategoryID" class="product-list-container"
        style="display: flex; flex-wrap: wrap; gap: 20px;">
        @if (Model.Products.Any())
        {
            @foreach (var product in Model.Products)
            {
                var isFavorited = Model.FavoriteProducts?.Any(fp => fp.ProductID == product.ProductID) ?? false;
                var activePromotion = Model.ActivePromotions?.FirstOrDefault(p => p.PromotionDetails.Any(pd =>
                pd.ProductID == product.ProductID &&
                pd.Promotion.EndDate >= DateTime.Now &&
                pd.Promotion.StartDate <= DateTime.Now));
                var promotionDetail = activePromotion?.PromotionDetails.FirstOrDefault(pd => pd.ProductID == product.ProductID);

                <div class="product-item"
                    style="flex: 1 1 200px; max-width: 200px; border: 1px solid #ddd; padding: 10px; border-radius: 5px;">
                    <img data-is-favorited="@isFavorited.ToString().ToLower()"
                        onclick="toggleFavorite(@product.ProductID, this)" class="icon-fav"
                        src="~/images/@(isFavorited ? "favor.png" : "unfavor.png")" style="width: 20px; height: 20px;" />
                    @if (product.Images != null && product.Images.Any())
                    {
                        <img class="product-image" src="~/images/@product.Images.FirstOrDefault(img => img.IsMainImage)?.ImagePath"
                            alt="@product.ProductName" style="width: 100%; height: 150px; object-fit: contain;">
                    }
                    else
                    {
                        <img class="product-image" src="~/images/default-image.png" alt="@product.ProductName"
                            style="width: 100%; height: 150px;">
                    }
                    <h3 class="product-name" style="font-size: 1em; margin: 5px 0;">@product.ProductName</h3>
                    <div class="product-info">
                        @if (promotionDetail != null)
                        {
                            <p class="product-price">
                                Giá: <del>@product.Price.ToString("N0") VNĐ</del>
                            </p>
                            <p class="product-discount" style="color:red;">
                                Giá khuyến mãi: <b>@promotionDetail.NewPrice.ToString("N0") VNĐ</b>
                            </p>
                        }
                        else
                        {
                            <p class="product-price">
                                Giá: <b>@product.Price.ToString("N0") VNĐ</b>
                            </p>
                        }
                    </div>
                    <div class="product-btn"><a href="@Url.Action("Detail", "Home", new { id = product.ProductID })" class="btn"
                            style="display: inline-block; padding: 5px 10px; background-color: #007bff; color: white; text-decoration: none; border-radius: 3px;">Chi
                            tiết</a></div>
                </div>
            }
        }
        else
        {
            <p>Không có sản phẩm nào trong danh mục này.</p>
        }
    </div>

    <!-- Pagination -->
    <div class="pagination-container"
        style="display: flex; justify-content: space-between; align-items: center; margin-top: 10px;">
        @if (Model.CurrentPage > 1)
        {
            <a href="@Url.Action("Index", "Home", new { page = Model.CurrentPage - 1, search = Model.SearchQuery, danhmuc = Model.Categories.FirstOrDefault()?.CategoryID })"
                class="page-btn" style="text-decoration: none; color: #007bff; padding: 5px 10px;">
                <i class="fas fa-chevron-left"></i> Quay lại
            </a>
        }

        <span class="page-info" style="font-size: 0.9em; color: #666;">Trang @Model.CurrentPage/@Model.TotalPages</span>

        @if (Model.CurrentPage < Model.TotalPages)
        {
            <a href="@Url.Action("Index", "Home", new { page = Model.CurrentPage + 1, search = Model.SearchQuery, danhmuc = Model.Categories.FirstOrDefault()?.CategoryID })"
                class="page-btn" style="text-decoration: none; color: #007bff; padding: 5px 10px;">
                Tiếp tục <i class="fas fa-chevron-right"></i>
            </a>
        }
    </div>
</div>

<style>
    .category-product-grid {
        margin-bottom: 40px;
    }

    .category-title {
        font-size: 1.5em;
        margin-bottom: 20px;
        color: #333;
    }

    .product-list-container {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
    }

    .product-item {
        flex: 1 1 200px;
        max-width: 200px;
        border: 1px solid #ddd;
        padding: 10px;
        border-radius: 5px;
        text-align: center;
    }

    .product-image {
        width: 100%;
        height: 150px;
    }

    .product-btn .btn:hover {
        background-color: #0056b3;
    }

    .pagination-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 10px;
    }

    .page-btn:hover {
        text-decoration: underline;
    }
</style>