@model BachHoaXanh.ViewModels.CartView

@{
    ViewData["Title"] = "Giỏ hàng";
}
<style>
    .payment-method, .address-selector {
        margin: 20px 0;
    }

    .payment-method label, .address selector label {
        font-size: 16px;
        margin-bottom: 10px;
        display: block;
        font-weight: bold;
    }

    .address-selector .address-item {
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 10px;
        margin-bottom: 10px;
        background-color: #fff;
        cursor: pointer;
        transition: border-color 0.3s ease;
    }

    .address-selector .address-item:hover {
        border-color: #007bff;
    }

    .address-selector .address-item input[type="radio"] {
        margin-right: 10px;
    }

    .address-selector .address-item label {
        font-size: 14px;
        margin: 0;
        cursor: pointer;
    }

    .btn-link {
        font-size: 14px;
        margin-top: 10px;
        display: inline-block;
    }

    .alert {
        padding: 15px;
        margin-bottom: 20px;
        border: 1px solid transparent;
        border-radius: 4px;
    }

    .alert-success {
        color: #155724;
        background-color: #d4edda;
        border-color: #c3e6cb;
    }

    .alert-danger {
        color: #721c24;
        background-color: #f8d7da;
        border-color: #f5c6cb;
    }

    .alert-warning {
        color: #856404;
        background-color: #fff3cd;
        border-color: #ffeeba;
    }
</style>
<div class="container-wrapper">
    @await Html.PartialAsync("_SidebarOverplay")

    <div class="breadcrumb-container">
        <div class="breadcrumb-icon d-inline-block">
            <i class="fas fa-chevron-left"></i>
        </div>
        <p>Danh sách sản phẩm trong giỏ hàng của bạn</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (TempData["CartMessage"] != null)
    {
        <div class="alert alert-warning">
            @TempData["CartMessage"]
        </div>
    }

    @await Html.PartialAsync("_CartPartial", Model)
</div>

<script>
    // Payment method handling
    document.getElementById("paymentMethod")?.addEventListener("change", function () {
        const selectedPaymentMethod = parseInt(this.value, 10);
        updatePaymentMethod(selectedPaymentMethod);
    });

    function updatePaymentMethod(selectedPaymentMethod) {
        $.ajax({
            url: '@Url.Action("UpdatePaymentMethod", "Cart")',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify(selectedPaymentMethod),
            type: 'POST',
            success: function (response) {
                console.log(response.message);
                updateCartItems(); // Refresh cart after payment method update
            },
            error: function (err) {
                console.error('Error updating payment method:', err);
                alert('Không thể cập nhật phương thức thanh toán. Vui lòng thử lại.');
            }
        });
    }

    // Clear cart handling
    document.getElementById("clearCartButton")?.addEventListener("click", function () {
        if (confirm("Bạn có chắc chắn muốn xoá hết giỏ hàng?")) {
            clearCart();
        }
    });

    function clearCart() {
        $.ajax({
            url: '@Url.Action("ClearAllCart", "Cart")',
            type: 'POST',
            success: function (response) {
                window.location.reload();
            },
            error: function (err) {
                console.error('Error clearing cart:', err);
                alert('Không thể xoá giỏ hàng. Vui lòng thử lại.');
            }
        });
    }

    // Order creation handling
    document.querySelector(".order-btn")?.addEventListener("click", function (event) {
        event.preventDefault();
        createOrder();
    });

    function createOrder() {
        const shippingAddressID = document.querySelector('input[name="shippingAddress"]:checked')?.value;
        const note = document.getElementById('orderNote')?.value.trim() || '';

        if (!shippingAddressID) {
            alert("Vui lòng chọn địa chỉ giao hàng!");
            return;
        }

        if (confirm("Bạn có chắc muốn đặt hàng?")) {
            $.ajax({
                url: '@Url.Action("CreateOrder", "Cart")',
                type: 'POST',
                data: {
                    shippingAddressID: shippingAddressID,
                    note: note
                },
                success: function (response) {
                    if (response.redirectUrl) {
                        // Chuyển hướng đến trang thanh toán VNPay
                        window.location.href = response.redirectUrl;
                    } else {
                        alert(response.message || "Đơn hàng đã được tạo thành công!");
                        window.location.reload();
                    }
                },
                error: function (xhr) {
                    const errorMessage = xhr.responseJSON?.message || "Có lỗi xảy ra khi tạo đơn hàng.";
                    alert(errorMessage);
                }
            });
        }
    });
    function formatCurrency(value) {
        return new Intl.NumberFormat('vi-VN').format(value) + 'đ';
    }

    function updateCartItems() {
        let grandTotal = 0;
        const cartItemsData = [];
        
        document.querySelectorAll('.cart-item').forEach(item => {
            const productId = parseInt(item.dataset.productId, 10);
            const quantityInput = item.querySelector('.qty');
            const quantity = parseInt(quantityInput.value, 10);
            const price = parseFloat(item.querySelector('.product-price').value);
            const maxStock = parseInt(quantityInput.getAttribute('max'), 10);

            // Validate quantity
            if (quantity > maxStock) {
                alert(`Số lượng vượt quá tồn kho. Tối đa: ${maxStock}`);
                quantityInput.value = maxStock;
                return;
            }

            const totalPrice = price * quantity;
            grandTotal += totalPrice;
            item.querySelector('.cart-price').textContent = formatCurrency(totalPrice);

            cartItemsData.push({ 
                productId: productId, 
                quantity: quantity 
            });
        });

        // Update total displays
        document.querySelectorAll('.grand-total').forEach(el => {
            el.textContent = formatCurrency(grandTotal);
        });

        // Update cart in backend
        if (cartItemsData.length > 0) {
            $.ajax({
                url: '@Url.Action("UpdateCart", "Cart")',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify(cartItemsData),
                type: 'POST',
                success: function (response) {
                    updateCartCount();
                },
                error: function (xhr) {
                    const errorMessage = xhr.responseJSON?.message || "Có lỗi xảy ra khi cập nhật giỏ hàng.";
                    alert(errorMessage);
                }
            });
        }
    }

    function removeFromCart(productId) {
        if (confirm('Bạn có chắc muốn xóa sản phẩm này khỏi giỏ hàng?')) {
            $.ajax({
                url: '@Url.Action("RemoveCart", "Cart")',
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify(productId),
                success: function (response) {
                    if (response.success) {
                        updateCartCount();
                        location.reload();
                    }
                },
                error: function (err) {
                    console.error('Error removing product:', err);
                    alert('Không thể xóa sản phẩm. Vui lòng thử lại.');
                }
            });
        }
    }

    function updateCartCount() {
        $.ajax({
            url: '@Url.Action("GetCartItemCount", "Cart")',
            type: 'GET',
            success: function (count) {
                document.querySelectorAll('.cart-amount').forEach(el => {
                    el.textContent = count;
                });
            }
        });
    }

    function decreaseQuantity(productId) {
        const quantityInput = document.getElementById(`quantity-${productId}`);
        const currentValue = parseInt(quantityInput.value, 10);
        const minValue = parseInt(quantityInput.min, 10) || 1;
        
        if (currentValue > minValue) {
            quantityInput.value = currentValue - 1;
            updateCartItems();
        }
    }

    function increaseQuantity(productId) {
        const quantityInput = document.getElementById(`quantity-${productId}`);
        const currentValue = parseInt(quantityInput.value, 10);
        const maxValue = parseInt(quantityInput.max, 10);
        
        if (currentValue < maxValue) {
            quantityInput.value = currentValue + 1;
            updateCartItems();
        } else {
            alert(`Số lượng đã đạt tối đa (${maxValue})`);
        }
    }

    // Initialize cart on page load
    document.addEventListener('DOMContentLoaded', () => {
        updateCartItems();
        
        // Add input event listeners to quantity inputs
        document.querySelectorAll('.qty').forEach(input => {
            input.addEventListener('change', function() {
                const value = parseInt(this.value, 10);
                const min = parseInt(this.min, 10) || 1;
                const max = parseInt(this.max, 10);
                
                if (value < min) {
                    this.value = min;
                } else if (value > max) {
                    this.value = max;
                    alert(`Số lượng vượt quá tồn kho. Tối đa: ${max}`);
                }
                
                updateCartItems();
            });
        });
    });
</script>