@model BachHoaXanh.ViewModels.CartView

@{
    ViewData["Title"] = "Giỏ hàng";
}
<style>
    .payment-method, .address-selector {
        margin: 20px 0;
    }

    .payment-method label, .address selector label {
        font-size: 16px;
        margin-bottom: 10px;
        display: block;
        font-weight: bold;
    }

    .address-selector .address-item {
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 10px;
        margin-bottom: 10px;
        background-color: #fff;
        cursor: pointer;
        transition: border-color 0.3s ease;
    }

    .address-selector .address-item:hover {
        border-color: #007bff;
    }

    .address-selector .address-item input[type="radio"] {
        margin-right: 10px;
    }

    .address-selector .address-item label {
        font-size: 14px;
        margin: 0;
        cursor: pointer;
    }

    .btn-link {
        font-size: 14px;
        margin-top: 10px;
        display: inline-block;
    }
</style>
<div class="container-wrapper">
    @await Html.PartialAsync("_SidebarOverplay")

    <div class="breadcrumb-container">
        <div class="breadcrumb-icon d-inline-block">
            <i class="fas fa-chevron-left"></i>
        </div>
        <p>Danh sách sản phẩm trong giỏ hàng của bạn</p>
    </div>

    <!-- Address selector with radio buttons -->
    

    @await Html.PartialAsync("_CartPartial", Model)
</div>

<script>
    document.getElementById("paymentMethod")?.addEventListener("change", function () {
        const selectedPaymentMethod = parseInt(this.value, 10);
        $.ajax({
            url: '@Url.Action("UpdatePaymentMethod", "Cart")',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify(selectedPaymentMethod),
            type: 'POST',
            success: function (response) {
                console.log(response.message);
            },
            error: function (err) {
                console.error('Error updating payment method:', err);
            }
        });
    });

    document.getElementById("clearCartButton")?.addEventListener("click", function () {
        if (confirm("Bạn có chắc chắn muốn xoá hết giỏ hàng?")) {
            $.ajax({
                url: '@Url.Action("ClearAllCart", "Cart")',
                type: 'POST',
                success: function (response) {
                    window.location.reload();
                },
                error: function (err) {
                    console.error('Error clearing cart:', err);
                }
            });
        }
    });

    document.querySelector(".order-btn")?.addEventListener("click", function (event) {
        const shippingAddressID = document.querySelector('input[name="shippingAddress"]:checked')?.value;
        const note = document.getElementById('orderNote')?.value.trim() || '';

        // Kiểm tra nếu chưa chọn địa chỉ
        if (!shippingAddressID) {
            alert("Vui lòng chọn địa chỉ giao hàng!");
            event.preventDefault();
            return;
        }

        if (confirm("Bạn có chắc muốn đặt hàng?")) {
            $.ajax({
                url: '@Url.Action("CreateOrder", "Cart")',
                type: 'POST',
                data: {
                    shippingAddressID: shippingAddressID,
                    note: note
                },
                success: function (response) {
                    alert(response.message || "Đơn hàng đã được tạo thành công!");
                    window.location.reload();
                },
                error: function (xhr) {
                    const errorMessage = xhr.responseJSON?.message || "Có lỗi xảy ra khi tạo đơn hàng.";
                    alert(errorMessage);
                    console.error('Error creating order:', xhr);
                }
            });
        }
    });

    function formatCurrency(value) {
        return new Intl.NumberFormat('vi-VN').format(value) + 'đ';
    }

    function updateCartItems() {
        let grandTotal = 0;
        const cartItemsData = Array.from(document.querySelectorAll('.cart-item')).map(item => {
            const productId = item.dataset.productId;
            const quantity = parseInt(item.querySelector('.qty').value, 10);
            const price = parseFloat(item.querySelector('.product-price').value);

            const totalPrice = price * quantity;
            grandTotal += totalPrice;
            item.querySelector('.cart-price').textContent = formatCurrency(totalPrice);

            return { productId, quantity };
        });

        document.querySelector('.grand-total').textContent = formatCurrency(grandTotal);

        const orderBtnGrandTotal = document.querySelector('.order-btn .grand-total');
        if (orderBtnGrandTotal) {
            orderBtnGrandTotal.textContent = formatCurrency(grandTotal);
        }

        $.ajax({
            url: '@Url.Action("UpdateCart", "Cart")',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify(cartItemsData),
            type: 'POST',
            success: function (data) {
                console.log('Cart updated successfully.');
            },
            error: function (err) {
                console.log('Error updating cart:', err);
            }
        });
    }

    function removeFromCart(productId) {
        $.ajax({
            url: '@Url.Action("RemoveCart", "Cart")',
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify(productId),
            success: function (data) {
                updateCartCount();
                updateCartItems();
                location.reload();
            },
            error: function (err) {
                console.log('Error removing product:', err);
            }
        });
    }

    function updateCartCount() {
        $.ajax({
            url: '/cart/count',
            type: 'GET',
            success: function (data) {
                $('.cart-amount').text(data);
            },
            error: function (err) {
                console.log('Error fetching cart count:', err);
            }
        });
    }

    function decreaseQuantity(productId) {
        const quantityInput = document.getElementById(`quantity-${productId}`);
        const currentValue = parseInt(quantityInput.value, 10);
        if (currentValue > parseInt(quantityInput.min, 10)) {
            quantityInput.value = currentValue - 1;
            updateCartItems();
        }
    }

    function increaseQuantity(productId) {
        const quantityInput = document.getElementById(`quantity-${productId}`);
        const currentValue = parseInt(quantityInput.value, 10);
        if (currentValue < parseInt(quantityInput.max, 10)) {
            quantityInput.value = currentValue + 1;
            updateCartItems();
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        updateCartItems();
    });

    function openPaymentMethodModal() {
        $('#paymentMethodModal').modal('show');
    }
</script>